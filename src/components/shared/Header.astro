---
import { useTranslations, type Locale } from '../../i18n';
import { getRelativeLocaleUrl } from 'astro:i18n';
import LocaleSwitcher from '../features/LocaleSwitcher.astro';

const { 
  year = "2026", 
  location = "VITORIA GASTEIZ", 
  festivalLogo = "/images/logo-midnightboogie.svg" 
} = Astro.props;

const lang = (Astro.currentLocale || 'es') as Locale;
const t = useTranslations(lang);

// ✅ FIX: wrapper function con ambos argumentos
const getLocaleUrl = (path: string) => getRelativeLocaleUrl(lang, path);

const locationLines = location.split(" ");
const currentPath = Astro.url.pathname;

const navLinks = [
  { path: '/programa', key: 'nav.programa' as const },
  { path: '/artistas', key: 'nav.artistas' as const },
  { path: '/entradas', key: 'nav.entradas' as const },
  { path: '/archivo', key: 'nav.archivo' as const },
  { path: '/contacto', key: 'nav.contacto' as const },
];

const getNavClass = (path: string) => {
  const baseClass = "relative text-black font-bold text-xs uppercase tracking-widest hover:opacity-60 transition-opacity";
  const activeClass = currentPath.startsWith(getLocaleUrl(path)) ? " active-link" : "";
  return baseClass + activeClass;
};

const getMobileClass = (path: string) => {
  const baseClass = "text-black font-bold text-lg uppercase transition-opacity";
  const activeClass = currentPath.startsWith(getLocaleUrl(path)) ? " opacity-60" : "";
  return baseClass + activeClass;
};
---

<header class="fixed top-0 left-0 right-0 z-50 w-full bg-brand shadow-md">
  <div class="max-w-7xl mx-auto px-6 md:px-12">
    <div class="grid grid-cols-[1fr_auto_1fr] items-center py-4">
      <div class="text-left">
        <span class="font-display text-lg md:text-4xl font-light text-black">
          {year}
        </span>
      </div>
      
      <div class="text-center px-4">
        <a href={getLocaleUrl('/')} class="block">
          <img 
            src={festivalLogo} 
            alt="Midnight Boogie" 
            class="h-12 md:h-14 object-contain mx-auto" 
          />
        </a>
      </div>
      
      <div class="flex justify-end items-center">
        <div class="hidden md:block">
          <div class="font-display text-sm font-bold text-black text-justify text-justify-last leading-tight">
            {locationLines.map((word) => (
              <span class="block">{word}</span>
            ))}
          </div>
        </div>
        
        <button 
          id="menu-toggle"
          class="md:hidden text-black ml-4"
          aria-label={t('menu.open')}
          aria-expanded="false"
        >
          <svg class="w-8 h-8" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
        </button>
      </div>
    </div>
    
<nav class="hidden md:flex justify-center gap-8 pb-4 border-t border-brand-border pt-3 mt-1 relative">
  {navLinks.map(({ path, key }) => (
    <a href={getLocaleUrl(path)} class={getNavClass(path)}>{t(key)}</a>
  ))}

<div class="absolute right-0 top-1/2 -translate-y-1/2">
  <LocaleSwitcher variant="dropdown" />
</div>
</nav>
  </div>
  
<div id="mobile-menu" class="md:hidden hidden bg-brand border-t border-brand-border-accent">
  <div class="flex justify-center pt-4">
    <LocaleSwitcher />
  </div>
  <nav class="flex flex-col p-6 gap-4">
    {navLinks.map(({ path, key }) => (
      <a href={getLocaleUrl(path)} class={getMobileClass(path)}>{t(key)}</a>
    ))}
  </nav>
</div>
</header>

<script client:load>
  document.addEventListener('DOMContentLoaded', () => {
    const toggleBtn = document.getElementById('menu-toggle');
    const mobileMenu = document.getElementById('mobile-menu');
    const mobileLinks = mobileMenu ? mobileMenu.querySelectorAll('a') : [];

    if (toggleBtn && mobileMenu) {
      toggleBtn.addEventListener('click', () => {
        mobileMenu.classList.toggle('hidden');
        const isExpanded = toggleBtn.getAttribute('aria-expanded') === 'true';
        toggleBtn.setAttribute('aria-expanded', String(!isExpanded));
      });

      mobileLinks.forEach(link => {
        link.addEventListener('click', () => {
          mobileMenu.classList.add('hidden');
          toggleBtn.setAttribute('aria-expanded', 'false');
        });
      });
    }
  });
</script>

<style>
  .active-link::after {
    content: '';
    position: absolute;
    bottom: -6px;
    left: 0;
    right: 0;
    height: 1px;
    background-color: black;
    border-radius: 999px;
  }
</style>