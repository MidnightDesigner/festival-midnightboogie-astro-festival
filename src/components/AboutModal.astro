---
// src/components/AboutModal.astro
import TextMeta from './DesignSystem/TextMeta.astro';
import Divider from './DesignSystem/Divider.astro';
---

<!-- ✅ BOTÓN TRIGGER: Misma tipografía exacta que los headings del footer -->
<button 
  id="open-about-modal"
  class="text-black text-xs md:text-sm font-medium uppercase tracking-[0.25em] mb-4 cursor-pointer hover:opacity-60 transition-opacity text-center md:text-left bg-transparent border-none p-0"
  aria-haspopup="dialog"
>
  Quiénes somos
</button>

<!-- Modal -->
<div 
  id="about-modal"
  class="fixed inset-0 z-[100] hidden items-center justify-center p-4"
  role="dialog"
  aria-modal="true"
  aria-labelledby="about-modal-title"
>
  <!-- Overlay oscuro -->
  <div 
    class="absolute inset-0 bg-black/80 backdrop-blur-sm modal-overlay"
    aria-hidden="true"
  ></div>

  <!-- Contenido del modal -->
<div class="relative bg-neutral-900 rounded-2xl max-w-2xl w-full max-h-[85vh] overflow-y-auto shadow-2xl">
    
    <!-- Botón cerrar (X) -->
    <button 
      id="close-about-modal"
      class="absolute top-4 right-4 w-10 h-10 flex items-center justify-center rounded-full bg-neutral-800 hover:bg-[rgb(233,157,56)] hover:text-neutral-950 text-white transition-colors z-10"
      aria-label="Cerrar"
    >
      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-5 h-5">
        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>

    <!-- Contenido interno -->
    <div class="p-8 md:p-12">
      
      <!-- Título de la modal -->
      <h2 id="about-modal-title" class="font-avantgarde text-white text-3xl md:text-4xl font-light uppercase tracking-tight mb-6 pr-12 text-center md:text-left">
        Quiénes somos
      </h2>


      <div class="space-y-6">
        <p class="text-white/80 text-sm md:text-base font-light leading-relaxed">
          Ante todo, somos un@s apasionad@s del R&B, del Soul, del R'n'R, del Jazz... y del resto de las <span class="text-[rgb(233,157,56)] font-medium">"músicas del Diablo"</span>.
        </p>
        
        <p class="text-white/80 text-sm md:text-base font-light leading-relaxed">
          Eso nos ha llevado a embarcarnos en este proyecto y a trabajar año tras año para que podáis disfrutar de actividades musicales y también educativas y culturales en un fin de semana muy especial.
        </p>

      <div class="text-white/80 text-sm md:text-base font-light leading-relaxed">
      <p>Os agradecemos sinceramente que nos sigáis acompañando en este viaje.</p>
      <p class="mt-4">Un saludo,</p>
       <p class="mt-2 text-white font-medium">Igu e Isabel</p>
      </div>

        <Divider width="w-full" color="bg-white/10" margin="my-8" />

         <!-- Datos legales con alineación PERFECTA usando Grid -->
        <div class="mt-6">
          <p class="text-white/80 text-sm md:text-base font-light leading-relaxed mb-6">
            <span class="text-[rgb(233,157,56)] font-medium uppercase tracking-wider">Midnight Boogie</span>, Asociación Cultural sin ánimo de lucro, es la organizadora de este evento.
          </p>

          <!-- ✅ GRID con items-baseline para alinear líneas base del texto -->
          <div class="grid grid-cols-[auto_1fr] gap-x-6 gap-y-3 md:gap-y-4 items-baseline">
            
            <!-- Fila 1 -->
            <span class="text-white/50 uppercase tracking-wider text-[10px] md:text-xs font-medium">CIF:</span>
            <span class="text-white/80 text-sm md:text-base font-light">G67682088</span>

            <!-- Fila 2 -->
            <span class="text-white/50 uppercase tracking-wider text-[10px] md:text-xs font-medium">Domicilio:</span>
            <span class="text-white/80 text-sm md:text-base font-light">Vitoria-Gasteiz</span>

            <!-- Fila 3 -->
            <span class="text-white/50 uppercase tracking-wider text-[10px] md:text-xs font-medium">Registro:</span>
            <span class="text-white/80 text-sm md:text-base font-light">Gobierno Vasco Nº AS/A/23878/2021</span>
            
          </div>
        </div>

        <Divider width="w-full" color="bg-white/10" margin="my-8" />

        <p class="text-white/80 text-sm md:text-base font-light leading-relaxed">
          Contamos con la colaboración de la <span class="text-[rgb(233,157,56)] font-medium">Fundación Vital Fundazioa</span>, a la que estamos muy agradecidos por su apoyo todos estos años.
        </p>
      </div>


    </div>
  </div>
</div>

<style>
  /* Animación de entrada */
  #about-modal.active {
    display: flex;
    animation: fadeIn 0.3s ease-out;
  }

  #about-modal.active > div:last-child {
    animation: slideUp 0.3s ease-out;
  }

  @keyframes fadeIn {
    from { opacity: 0; }
    to { opacity: 1; }
  }

  @keyframes slideUp {
    from { 
      opacity: 0;
      transform: translateY(20px);
    }
    to { 
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* Bloquear scroll del body cuando el modal está abierto */
  body.modal-open {
    overflow: hidden;
  }
</style>

<script>
  function closeModal() {
    const modal = document.getElementById('about-modal');
    modal?.classList.remove('active');
    document.body.classList.remove('modal-open');
  }

  document.addEventListener('click', (e) => {
    // Abrir
    if (e.target.closest('#open-about-modal')) {
      const modal = document.getElementById('about-modal');
      modal?.classList.add('active');
      document.body.classList.add('modal-open');
      return;
    }

    // Cerrar (botón X o botón "Entendido")
if (e.target.closest('#close-about-modal')) {
        closeModal();
      return;
    }

    // Cerrar (clic en el overlay oscuro)
    if (e.target.closest('.modal-overlay')) {
      closeModal();
    }
  });

  // Cerrar con tecla Escape
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') {
      closeModal();
    }
  });
</script>