---
import { pastEditions } from '~/data/archivo';
import PageHero from '~/components/ui/PageHero.astro';
import Button from '~/components/ui/Button.astro';
import { getContent } from '~/i18n/content';
import { getRelativeLocaleUrl } from 'astro:i18n';

const lang = Astro.currentLocale || 'es';
const c = getContent(lang).archivo;
const contactoUrl = getRelativeLocaleUrl(lang, 'contacto');

const ediciones = pastEditions.map((edition) => {
  const override = c.ediciones?.[edition.title] ?? {};
  return {
    ...edition,
    ...override
  };
});
---

<div class="max-w-7xl mx-auto px-6 md:px-12 pb-12 relative z-10">
  <PageHero title={c.heroTitle} size="sm" subtitle={c.heroSubtitle} />

  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 mb-16">
    {ediciones.map((edition) => (
      <article
        class:list={[
          'group bg-surface border border-border rounded-card overflow-hidden hover:border-brand/40 transition-all duration-300 flex flex-col',
          edition.image && 'cursor-pointer'
        ]}
        data-flyer-card
        data-title={edition.title}
        data-front={edition.image ?? ''}
        data-back={edition.imageBack ?? ''}
      >
        <div class="aspect-[3/4] bg-background relative overflow-hidden">
          {edition.image ? (
            <img
              src={edition.image}
              alt={`Flyer ${edition.title}`}
              class="w-full h-full object-contain group-hover:scale-105 transition-transform duration-500"
              loading="lazy"
              decoding="async"
            />
          ) : (
            <div class="absolute inset-0 flex items-center justify-center">
              <span class="font-display text-6xl text-foreground/20">{edition.year}</span>
            </div>
          )}

          <div class="absolute inset-0 bg-overlay-medium opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex items-center justify-center pointer-events-none">
            {edition.image ? (
              <span class="px-6 py-3 bg-brand text-background font-semibold rounded-button">
                {c.viewFlyer}
              </span>
            ) : (
              <span class="text-foreground-muted font-semibold">{c.comingSoon}</span>
            )}
          </div>
        </div>

        <div class="p-4 flex flex-col flex-grow">
          <h2 class="font-display text-2xl mb-1 group-hover:text-brand transition-colors text-foreground">
            {edition.title}
          </h2>
          <p class="text-brand text-sm mb-3 font-medium">{edition.dates}</p>
          {edition.description && (
            <p class="text-foreground-muted text-sm leading-relaxed flex-grow">{edition.description}</p>
          )}
        </div>
      </article>
    ))}
  </div>

  <div class="max-w-3xl mx-auto mt-12 mb-8 flex flex-col items-center bg-surface backdrop-blur-md border border-brand/50 rounded-card px-8 py-10 md:px-12 md:py-12 text-center">
    <h2 class="font-display text-foreground text-2xl md:text-3xl font-light uppercase tracking-tight mb-4 drop-shadow-lg">
      {c.ctaTitle}
    </h2>
    <p class="text-foreground-muted text-sm md:text-base font-light leading-relaxed mb-8 max-w-xl">
      {c.ctaDescription}
    </p>
    <Button href={contactoUrl} variant="primary">
      {c.ctaButton}
    </Button>
  </div>
</div>

<dialog id="flyer-dialog" class="bg-transparent p-0 backdrop:bg-overlay-heavy" data-front="" data-back="" data-title="">
  <div class="relative flex items-center justify-center m-auto w-fit">
    <button
      id="flyer-close"
      class="cursor-pointer absolute top-2 right-2 z-10 p-2 bg-surface rounded-full text-foreground hover:text-brand transition-colors"
      aria-label="Cerrar"
    >
      <svg class="w-7 h-7" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>

    <img
      id="flyer-image"
      src=""
      alt=""
      class="max-h-[75vh] max-w-[88vw] w-auto rounded-card shadow-2xl select-none block"
      draggable="false"
    />

    <button
      id="face-next"
      class="cursor-pointer absolute right-3 top-1/2 -translate-y-1/2 p-2 bg-surface/70 rounded-full text-foreground hover:text-brand transition-colors hidden"
      aria-label="Ver la otra cara del flyer"
    >
      <svg class="w-10 h-10" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
      </svg>
    </button>

    <button
      id="face-prev"
      class="cursor-pointer absolute left-3 top-1/2 -translate-y-1/2 p-2 bg-surface/70 rounded-full text-foreground hover:text-brand transition-colors hidden"
      aria-label="Volver a la portada del flyer"
    >
      <svg class="w-10 h-10" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
      </svg>
    </button>
  </div>
</dialog>

<script>
  document.addEventListener('click', (e) => {
    const target = e.target as HTMLElement;
    const dialog = document.getElementById('flyer-dialog') as HTMLDialogElement;
    const imgEl = document.getElementById('flyer-image') as HTMLImageElement;
    const nextBtn = document.getElementById('face-next') as HTMLButtonElement;
    const prevBtn = document.getElementById('face-prev') as HTMLButtonElement;

    if (!dialog || !imgEl) return;

    const card = target.closest('[data-flyer-card]');
    if (card && !dialog.open) {
      e.preventDefault();
      const front = card.dataset.front ?? '';
      const back = card.dataset.back ?? '';
      const title = card.dataset.title ?? '';

      if (!front) return;

      dialog.dataset.front = front;
      dialog.dataset.back = back;
      dialog.dataset.title = title;

      imgEl.src = front;
      imgEl.alt = `Flyer ${title}`;

      if (back) {
        nextBtn.classList.remove('hidden');
        prevBtn.classList.add('hidden');
      } else {
        nextBtn.classList.add('hidden');
      }

      dialog.showModal();
      return;
    }

    if (target.closest('#flyer-close') || target === dialog) {
      dialog.close();
      return;
    }

    if (target.closest('#face-next') && dialog.dataset.back) {
      imgEl.src = dialog.dataset.back;
      imgEl.alt = `Flyer ${dialog.dataset.title}`;
      nextBtn.classList.add('hidden');
      prevBtn.classList.remove('hidden');
      return;
    }

    if (target.closest('#face-prev') && dialog.dataset.front) {
      imgEl.src = dialog.dataset.front;
      imgEl.alt = `Flyer ${dialog.dataset.title}`;
      prevBtn.classList.add('hidden');
      if (dialog.dataset.back) {
        nextBtn.classList.remove('hidden');
      }
    }
  });
</script>