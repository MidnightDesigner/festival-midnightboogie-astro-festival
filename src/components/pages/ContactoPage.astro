---
import PageHero from '~/components/ui/PageHero.astro';
import SectionTitle from '~/components/ui/SectionTitle.astro';
import Divider from '~/components/ui/Divider.astro';
import TextMeta from '~/components/ui/TextMeta.astro';
import { getContent } from '~/i18n/content';

const lang = Astro.currentLocale || 'es';
const c = getContent(lang).contacto;

const EMAIL_CONTACTO = "info@midnightboogie.net";

const ICON_MAIL = `<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-6 h-6"><path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75" /></svg>`;

const ICON_PRESS = `<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-6 h-6"><path stroke-linecap="round" stroke-linejoin="round" d="M12 7.5h1.5m-1.5 3h1.5m-7.5 3h7.5m-7.5 3h7.5m3-9h3.375c.621 0 1.125.504 1.125 1.125V18a2.25 2.25 0 01-2.25 2.25M16.5 7.5V18a2.25 2.25 0 002.25 2.25M16.5 7.5V4.875c0-.621-.504-1.125-1.125-1.125H4.125C3.504 3.75 3 4.254 3 4.875V18a2.25 2.25 0 002.25 2.25h13.5M6 7.5h3v3H6v-3z" /></svg>`;

const MAPS_LINKS = [
  "https://maps.app.goo.gl/z98wijNCT9BhRG7E8",
  "https://maps.app.goo.gl/sbTHfNWDRANJksH28",
  "https://maps.app.goo.gl/GQKDK7qJDeTEd62e7",
  "https://maps.app.goo.gl/8NuYzMiBojJNHz1z9",
];

const contactInfo = [
  { icon: ICON_MAIL, title: c.infoTitle, detail: EMAIL_CONTACTO, link: `mailto:${EMAIL_CONTACTO}` },
  { icon: ICON_PRESS, title: c.pressTitle, detail: EMAIL_CONTACTO, link: `mailto:${EMAIL_CONTACTO}` },
];

const ubicaciones = c.ubicaciones.map((ubi, i) => ({ ...ubi, maps: MAPS_LINKS[i] }));
---

<section class="max-w-6xl mx-auto px-6 pb-16 md:pb-24 relative z-10">
  <PageHero title={c.heroTitle} subtitle={c.heroSubtitle} size="sm" />

  <Divider width="max-w-3xl" color="bg-brand/60" margin="mx-auto my-8 md:my-12" />

  <div class="max-w-3xl mx-auto space-y-8">
    <div class="space-y-8">
      {contactInfo.map((item) => (
        <a 
          href={item.link} 
          target={item.link.startsWith("http") ? "_blank" : "_self"}
          rel="noopener noreferrer"
          class="flex items-start gap-4 group p-4 rounded-xl hover:bg-surface transition-colors duration-300"
        >
          <div class="text-brand mt-1 group-hover:scale-110 transition-transform duration-300" set:html={item.icon}></div>
          
          <div class="flex flex-col gap-1">
            <TextMeta variant="contact-title" text={item.title} />
            <TextMeta variant="default" text={item.detail} />
          </div>
        </a>
      ))}

      <Divider width="w-full" color="bg-white/10" margin="my-4" />

      <div>
        <SectionTitle title={c.locationsTitle} />

        <div class="space-y-3">
          {ubicaciones.map((ubi) => (
            <a 
              href={ubi.maps} 
              target="_blank" 
              rel="noopener noreferrer"
              class="flex items-start gap-4 group p-4 rounded-xl hover:bg-surface transition-colors duration-300"
            >
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5 text-brand mt-1 flex-shrink-0 group-hover:scale-110 transition-transform duration-300">
                <path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z" />
                <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z" />
              </svg>
              
              <div class="flex flex-col gap-1">
                <TextMeta variant="location-title" text={ubi.nombre} />
                <TextMeta variant="location" text={ubi.direccion} />
                <TextMeta variant="tag" text={ubi.evento} />
              </div>
            </a>
          ))}
        </div>
      </div>

      <div class="mt-4 p-6 bg-surface border border-border rounded-xl">
        <TextMeta variant="date" text={c.noteLabel} class="mb-2" />
        <TextMeta variant="default" text={c.noteText} />
      </div>
    </div>
  </div>
</section>