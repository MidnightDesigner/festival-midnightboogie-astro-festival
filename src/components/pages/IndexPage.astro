---
const PAGE_CONFIG = {
  year: "2026",
  location: "VITORIA GASTEIZ",
  heroImage: "/images/2026/Midnightboogie-2026.avif",
  sponsorImage: "/images/vital/sponsor-vital.svg",
};
---

<a 
  href="/programa"
  class="relative block w-full group overflow-hidden" 
  aria-label="Ver programa del festival"
>
  <img 
    src={PAGE_CONFIG.heroImage} 
    alt={`Midnight Boogie Festival ${PAGE_CONFIG.year}`} 
    width="1488"
    height="1920"
    fetchpriority="high"
    decoding="async"
    class="w-full h-[calc(100vh-180px)] md:h-[calc(100vh-270px)] object-cover object-bottom md:object-center transition-transform duration-700 group-hover:scale-105"
  />

  <h1 class="sr-only">
    Midnight Boogie Festival {PAGE_CONFIG.year} - Soul, Blues & Rhythm & Blues en {PAGE_CONFIG.location}
  </h1>
  
  <div class="absolute inset-0 bg-black/10 pointer-events-none"></div>
  
  <div class="absolute bottom-6 left-6 md:bottom-10 md:left-10 z-20 pointer-events-none">
    <div class="flex items-center gap-3">
      <div class="w-8 h-[2px] bg-brand"></div>
      <span class="text-white/80 text-xs md:text-sm font-bold uppercase tracking-[0.25em] drop-shadow-lg">
        {PAGE_CONFIG.location}
      </span>
    </div>
  </div>
  
  <div class="absolute bottom-8 right-8 md:bottom-10 md:right-10 opacity-0 group-hover:opacity-100 transition-opacity duration-300 z-30 hidden md:block">
    <span class="bg-white/90 text-black px-6 py-3 rounded-full text-sm font-bold uppercase tracking-widest shadow-lg backdrop-blur-sm">
      Ver Programa
    </span>
  </div>
</a>

<section class="h-[100px] md:h-[150px] flex justify-center items-center bg-brand border-t border-black/10 shrink-0">
  <img 
    src={PAGE_CONFIG.sponsorImage} 
    alt="Sponsor Principal" 
    width="200"
    height="60"
    class="h-[60%] object-contain drop-shadow-md opacity-90"
  />
</section>