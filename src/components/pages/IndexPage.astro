---
import { useTranslations, type Locale } from '~/i18n';
import StarBackground from '~/components/ui/StarBackground.astro';
import HeroCTA from '~/components/ui/HeroCTA.astro';

const PAGE_CONFIG = {
  year: "2026",
  location: "VITORIA GASTEIZ",
  heroImage: "/images/2026/Midnightboogie-2026.avif",
  sponsorImage: "/images/vital/sponsor-vital.svg",
};

const lang = (Astro.currentLocale || 'es') as Locale;
const t = useTranslations(lang);
---

<!-- 1. Global Starry Background (Stays behind everything) -->
<StarBackground variant="subtle" />

<!-- 2. Main Content Wrapper (Forced above the background) -->
<main class="relative z-10 w-full">
  
  <!-- Hero Section -->
  <a 
    href="/programa"
    class="relative block w-full group overflow-hidden" 
    aria-label="Ver programa del festival"
  >
    <!-- Hero Cover Image -->
    <img 
      src={PAGE_CONFIG.heroImage} 
      alt={`Midnight Boogie Festival ${PAGE_CONFIG.year}`} 
      width="1488"
      height="1920"
      fetchpriority="high"
      decoding="async"
      class="w-full h-[calc(100vh-180px)] md:h-[calc(100vh-270px)] object-cover object-bottom md:object-center transition-transform duration-700 group-hover:scale-105"
    />

    <!-- Dramatic Stars (Contained strictly inside the hero) -->
    <div class="absolute inset-0 pointer-events-none" aria-hidden="true">
      <div class="stars hero-stars-xs"></div>
      <div class="stars hero-stars-sm"></div>
      <div class="stars hero-stars-md"></div>
      <div class="stars hero-stars-lg"></div>
      <div class="stars hero-stars-xl"></div>
    </div>

    <h1 class="sr-only">
      Midnight Boogie Festival {PAGE_CONFIG.year} - Soul, Blues & Rhythm & Blues en {PAGE_CONFIG.location}
    </h1>
    
    <div class="absolute inset-0 bg-black/20 pointer-events-none"></div>
    
    <div class="absolute bottom-6 left-6 md:bottom-10 md:left-10 z-20 pointer-events-none">
      <div class="flex items-center gap-3">
        <div class="w-8 h-[2px] bg-brand"></div>
        <span class="text-white/80 text-xs md:text-sm font-bold uppercase tracking-[0.25em] drop-shadow-lg">
          {PAGE_CONFIG.location}
        </span>
      </div>
    </div>
    
    <HeroCTA href="/programa" text={t('index.viewProgram')} />
  </a>

  <!-- Sponsor Section (Orange Box) -->
  <section class="h-[100px] md:h-[150px] flex justify-center items-center bg-brand border-t border-black/10 shrink-0">
    <img 
      src={PAGE_CONFIG.sponsorImage} 
      alt="Sponsor Principal" 
      width="200"
      height="60"
      class="h-[60%] object-contain drop-shadow-md opacity-90"
    />
  </section>

</main>

<style>
  /* === DRAMATIC HERO STARS === */
  .stars {
    position: absolute;
    inset: 0;
    pointer-events: none;
    will-change: transform, opacity;
  }

  .hero-stars-xs {
    background-image: radial-gradient(1px 1px at 20px 30px, rgba(255, 255, 255, 0.7), transparent), radial-gradient(1px 1px at 80px 120px, rgba(255, 255, 255, 0.5), transparent), radial-gradient(1px 1px at 150px 40px, rgba(255, 255, 255, 0.6), transparent), radial-gradient(1px 1px at 220px 180px, rgba(255, 255, 255, 0.4), transparent), radial-gradient(1px 1px at 300px 80px, rgba(255, 255, 255, 0.55), transparent), radial-gradient(1px 1px at 380px 220px, rgba(255, 255, 255, 0.45), transparent);
    background-size: 420px 280px;
    animation: twinkle-hero 4s ease-in-out infinite alternate;
  }

  .hero-stars-sm {
    background-image: radial-gradient(2px 2px at 50px 100px, rgba(255, 255, 255, 0.85), transparent), radial-gradient(2px 2px at 180px 200px, rgba(255, 255, 255, 0.7), transparent), radial-gradient(2px 2px at 280px 60px, rgba(255, 255, 255, 0.8), transparent), radial-gradient(2px 2px at 400px 160px, rgba(255, 255, 255, 0.65), transparent);
    background-size: 480px 300px;
    animation: twinkle-hero 6s ease-in-out infinite alternate-reverse;
  }

  .hero-stars-md {
    background-image: radial-gradient(3px 3px at 120px 80px, rgba(255, 255, 255, 0.95), transparent), radial-gradient(3px 3px at 260px 180px, rgba(255, 255, 255, 0.85), transparent), radial-gradient(3px 3px at 380px 100px, rgba(255, 255, 255, 0.9), transparent);
    background-size: 520px 340px;
    animation: twinkle-hero 8s ease-in-out infinite alternate;
  }

  .hero-stars-lg {
    background-image: radial-gradient(4px 4px at 90px 140px, rgba(255, 255, 255, 1), transparent), radial-gradient(4px 4px at 320px 220px, rgba(255, 255, 255, 0.95), transparent), radial-gradient(3.5px 3.5px at 450px 80px, rgba(255, 255, 255, 0.9), transparent);
    background-size: 600px 380px;
    animation: twinkle-hero 10s ease-in-out infinite alternate-reverse, drift-hero 80s linear infinite;
  }

  .hero-stars-xl {
    background-image: radial-gradient(5px 5px at 180px 120px, rgba(255, 255, 255, 1), transparent), radial-gradient(6px 6px at 420px 200px, rgba(255, 255, 255, 1), transparent);
    background-size: 700px 420px;
    animation: twinkle-dramatic 5s ease-in-out infinite;
  }

  @keyframes twinkle-hero {
    from { opacity: 0.3; transform: scale(0.92); }
    to { opacity: 1; transform: scale(1.1); }
  }

  @keyframes twinkle-dramatic {
    0%, 100% { opacity: 0.2; transform: scale(0.8); }
    50% { opacity: 1; transform: scale(1.25); }
  }

  @keyframes drift-hero {
    from { background-position: 0 0; }
    to { background-position: 120px 60px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-stars-xs, .hero-stars-sm, .hero-stars-md, .hero-stars-lg, .hero-stars-xl {
      animation: none;
      opacity: 0.85;
      transform: scale(1);
    }
  }
</style>