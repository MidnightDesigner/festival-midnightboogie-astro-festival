---
import TextMeta from './TextMeta.astro';
import Divider from './Divider.astro';
import Modal from './Modal.astro';
import { useTranslations, type Locale } from '../../i18n';

const lang = (Astro.currentLocale || 'es') as Locale;
const t = useTranslations(lang);
---

<button 
  onclick="document.getElementById('about-modal').showModal()"
  class="text-black text-xs md:text-sm font-medium uppercase tracking-widest mb-4 cursor-pointer hover:opacity-60 transition-opacity text-center md:text-left bg-transparent border-none p-0"
  aria-haspopup="dialog"
  aria-controls="about-modal"
>
  {t('footer.about')}
</button>

<Modal id="about-modal" title={t('footer.about')}>
  <div class="space-y-6">
    <p set:html={t('about.p1')} class="text-foreground/80 text-sm md:text-base font-light leading-relaxed"></p>
    
    <p set:html={t('about.p2')} class="text-foreground/80 text-sm md:text-base font-light leading-relaxed"></p>

    <div class="text-foreground/80 text-sm md:text-base font-light leading-relaxed">
      <p>{t('about.p3_1')}</p>
      <p class="mt-4">{t('about.p3_2')}</p>
      <p class="mt-2 text-foreground font-medium">{t('about.p3_3')}</p>
    </div>

    <Divider width="w-full" color="bg-border" margin="my-8" />

    <div class="mt-6">
      <p set:html={t('about.org')} class="text-foreground/80 text-sm md:text-base font-light leading-relaxed mb-6"></p>

      <div class="grid grid-cols-[auto_1fr] gap-x-6 gap-y-3 md:gap-y-4 items-baseline">
        <span class="text-foreground-disabled uppercase tracking-wider text-[10px] md:text-xs font-medium">{t('about.cif_label')}</span>
        <span class="text-foreground/80 text-sm md:text-base font-light">G67682088</span>

        <span class="text-foreground-disabled uppercase tracking-wider text-[10px] md:text-xs font-medium">{t('about.address_label')}</span>
        <span class="text-foreground/80 text-sm md:text-base font-light">Vitoria-Gasteiz</span>

        <span class="text-foreground-disabled uppercase tracking-wider text-[10px] md:text-xs font-medium">{t('about.registry_label')}</span>
        <span class="text-foreground/80 text-sm md:text-base font-light">Gobierno Vasco Nº AS/A/23878/2021</span>
      </div>
    </div>

    <Divider width="w-full" color="bg-border" margin="my-8" />

    <p set:html={t('about.sponsor')} class="text-foreground/80 text-sm md:text-base font-light leading-relaxed"></p>
  </div>
</Modal>