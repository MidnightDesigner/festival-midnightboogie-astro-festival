---
export interface Props {
  type?: 'warning' | 'info' | 'success';
  title?: string;
  message: string;
}

const { type = 'warning', title, message } = Astro.props;

const icons = {
  warning: '⚠️',
  info: 'ℹ️',
  success: '✅'
};

const typeColors = {
  warning: 'text-brand',
  info: 'text-blue-400',
  success: 'text-green-400'
};
---

<div class="max-w-3xl mx-auto mt-12 px-6 py-6 bg-surface/50 border border-border rounded-card text-center backdrop-blur-sm">
  {title && (
    <p class={`text-foreground text-sm md:text-base font-medium leading-relaxed mb-3 flex items-center justify-center gap-2 ${typeColors[type]}`}>
      <span class="text-xl" aria-hidden="true">{icons[type]}</span> 
      {title}
    </p>
  )}
  <p class="text-foreground-muted text-sm font-light leading-relaxed flex items-center justify-center gap-2">
    <span class={typeColors[type]} aria-hidden="true">{icons[type]}</span> 
    {message}
  </p>
</div>