---
export interface Props {
  text: string;
  ariaLabel?: string;
}

const { text, ariaLabel = text } = Astro.props;
---

<div 
  class="hidden md:block absolute bottom-10 right-10 z-30 transition-transform duration-300 group-hover:scale-105"
  aria-label={ariaLabel}
>
  <!-- ✅ Halved padding (px-3 py-1.5) and smaller text (text-xs) -->
  <span class="bg-white/90 text-black px-3 py-1.5 rounded-full text-xs font-bold uppercase tracking-wide shadow-lg backdrop-blur-sm flex items-center justify-center text-center">
    {text}
  </span>
</div>