---
export interface Props {
  text: string;
  ariaLabel?: string;
}

const { text, ariaLabel = text } = Astro.props;
---

<!-- Changed from <a> to <div> to fix HTML nesting rules -->
<div 
  class="absolute bottom-8 right-8 md:bottom-10 md:right-10 z-30 transition-transform duration-300 group-hover:scale-105"
  aria-label={ariaLabel}
>
  <span class="bg-white/90 text-black px-6 py-3 rounded-full text-sm font-bold uppercase tracking-widest shadow-lg backdrop-blur-sm block text-center">
    {text}
  </span>
</div>