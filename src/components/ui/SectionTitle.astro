---
interface Props {
  title: string;
  level?: 'h1' | 'h2' | 'h3' | 'h4';
  size?: 'sm' | 'md' | 'lg';
  align?: 'left' | 'center' | 'right';
  class?: string;
}

const { 
  title, 
  level = 'h2', 
  size = 'md',
  align = 'left',
  class: className = '' 
} = Astro.props;

const sizeClasses = {
  sm: 'text-base md:text-lg',
  md: 'text-xl md:text-2xl',
  lg: 'text-2xl md:text-3xl'
};

const alignClasses = {
  left: 'text-left',
  center: 'text-center mx-auto',
  right: 'text-right'
};

const baseClass = `font-display text-foreground font-light uppercase tracking-wider ${sizeClasses[size]} ${alignClasses[align]} ${className}`;


// Patrón senior para etiquetas dinámicas: evita conflictos del parser de Astro
const Tag = level;
---

<Tag class={baseClass}>
  {title}
</Tag>