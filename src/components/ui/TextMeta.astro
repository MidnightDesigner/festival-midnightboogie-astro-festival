---
interface Props {
  text: string;
  variant?: keyof typeof variants;
  icon?: string;
  class?: string;
}

const { text, variant = 'default', icon, class: className = '' } = Astro.props;

const variants = {
  date: "text-brand text-base md:text-lg font-bold uppercase tracking-widest",
  price: "text-foreground text-xl md:text-2xl font-light tracking-tight mb-4",
  location: "text-foreground/80 text-sm md:text-base font-light leading-relaxed",
  tag: "text-foreground-muted text-xs md:text-sm font-light uppercase tracking-wider mb-4",
  default: "text-foreground/70 text-sm md:text-base font-light leading-relaxed mb-4",
  meta: "text-foreground-muted text-xs md:text-sm font-light uppercase tracking-[0.25em]",
  "contact-title": "text-foreground text-lg font-light uppercase tracking-wider",
  "location-title": "text-foreground text-sm font-bold uppercase tracking-wider group-hover:text-brand transition-colors",
  "footer-heading": "text-black text-xs md:text-sm font-medium uppercase tracking-[0.25em] mb-4",
  "footer-link": "text-black/80 text-sm font-medium hover:text-black transition-colors duration-300",
  "footer-copy": "text-black/60 text-xs font-medium",
  "section-tag": "text-foreground/80 text-xs md:text-sm font-medium uppercase tracking-[0.3em] drop-shadow-md",
  "default-center": "text-foreground/70 text-sm md:text-base font-light leading-relaxed mb-6",
  "tag-center": "text-foreground-muted text-xs md:text-sm font-light uppercase tracking-wider mb-6",
  "badge": "inline-flex items-center justify-center px-4 py-1.5 rounded-full text-[11px] md:text-xs font-bold uppercase tracking-widest",
  "venue-name": "text-foreground text-sm md:text-base font-medium uppercase tracking-wider",
  "venue-address": "text-foreground-muted text-xs md:text-sm font-light leading-relaxed"
};

const isCentered = variant?.includes('center');
const baseClass = isCentered 
  ? "flex flex-col items-center justify-center w-full text-center" 
  : "inline-flex items-center gap-2";

const finalClass = `${baseClass} ${variants[variant]} ${className}`;
---

{isCentered ? (
  <div class={finalClass}>
    {icon && <span set:html={icon} class="w-4 h-4 flex-shrink-0 mb-2" />}
    {text}
  </div>
) : (
  <span class={finalClass}>
    {icon && <span set:html={icon} class="w-4 h-4 flex-shrink-0" />}
    {text}
  </span>
)}