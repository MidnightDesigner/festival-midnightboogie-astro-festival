---
interface Props {
  href?: string;
  variant?: 'primary' | 'secondary';
  size?: 'sm' | 'md';
  class?: string;
}

const { 
  href, 
  variant = 'primary', 
  size = 'md', 
  class: className = '' 
} = Astro.props;

const baseClasses = "inline-flex items-center justify-center gap-2 font-bold uppercase tracking-wider transition-all duration-300 rounded-button font-display cursor-pointer no-underline shrink-0";

const sizeClasses = size === 'sm' 
  ? "text-xs px-5 py-2" 
  : "text-sm px-8 py-3";

const variantClasses = variant === 'secondary'
  ? "bg-transparent border border-brand text-brand hover:bg-brand hover:text-background"
  : "bg-brand text-background hover:bg-white hover:scale-105 shadow-glow hover:shadow-2xl";

const finalClasses = `${baseClasses} ${sizeClasses} ${variantClasses} ${className}`;
const isExternal = href && href.startsWith('http');
---

{href ? (
  <a 
    href={href} 
    class={finalClasses} 
    target={isExternal ? "_blank" : undefined} 
    rel={isExternal ? "noopener noreferrer" : undefined}
  >
    <slot />
  </a>
) : (
  <button class={finalClasses} type="button">
    <slot />
  </button>
)}

<style>
  /* 
    Corrección óptica sistémica: 
    Sube 1px las imágenes e iconos dentro de botones para compensar 
    el centro visual más alto del texto en mayúsculas y el padding de los archivos.
  */
  a :global(img),
  a :global(svg),
  button :global(img),
  button :global(svg) {
    align-self: center;
    margin-top: -3px;
  }
</style>