---
interface Props {
  variant?: 'ticket' | 'artist' | 'text' | 'block';
}

const { variant = 'text' } = Astro.props;
---

{variant === 'ticket' && (
  <div class="animate-pulse bg-surface rounded-card border border-border p-6 md:p-8 space-y-4 h-full flex flex-col" aria-hidden="true">
    <div class="h-3 bg-foreground/10 rounded w-2/5"></div>
    <div class="h-2 bg-foreground/10 rounded w-1/4 mt-2"></div>
    <div class="h-8 md:h-12 bg-foreground/20 rounded w-4/5 mt-4"></div>
    <div class="h-[1px] bg-foreground/10 w-full my-4"></div>
    <div class="h-14 bg-foreground/10 rounded w-1/4"></div>
    <div class="flex gap-3 mt-2">
       <div class="h-3 bg-foreground/10 rounded w-1/4"></div>
       <div class="h-3 bg-foreground/10 rounded w-1/3"></div>
    </div>
    <div class="mt-auto pt-6">
      <div class="h-12 bg-brand/20 rounded-button w-full md:w-1/3"></div>
    </div>
  </div>
)}

{variant === 'artist' && (
  <div class="animate-pulse bg-surface rounded-card border border-border overflow-hidden h-full flex flex-col" aria-hidden="true">
    <div class="p-6 md:p-12 text-center space-y-4 flex flex-col items-center">
      <div class="h-8 bg-foreground/20 rounded w-2/3"></div>
      <div class="h-3 bg-foreground/10 rounded w-1/3"></div>
    </div>
    <div class="w-full aspect-[2/1] bg-surface"></div>
    <div class="p-6 md:p-12 space-y-3 flex-grow">
       <div class="h-3 bg-foreground/10 rounded w-full"></div>
       <div class="h-3 bg-foreground/10 rounded w-5/6"></div>
       <div class="h-3 bg-foreground/10 rounded w-2/3"></div>
    </div>
  </div>
)}

{variant === 'text' && (
  <div class="animate-pulse h-4 bg-foreground/10 rounded w-full" aria-hidden="true"></div>
)}

{variant === 'block' && (
  <div class="animate-pulse bg-surface border border-border rounded-card aspect-video" aria-hidden="true"></div>
)}