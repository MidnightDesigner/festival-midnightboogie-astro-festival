---
interface Props {
  title: string;
  highlight?: string;
  subtitle?: string;
  size?: 'sm' | 'md' | 'lg';
}

const { title, highlight, subtitle, size = 'md' } = Astro.props;

const titleSizes = {
  sm: "text-3xl md:text-4xl",
  md: "text-4xl md:text-5xl",
  lg: "text-5xl md:text-7xl"
};

const highlightSizes = {
  sm: "text-xl md:text-2xl",
  md: "text-2xl md:text-3xl",
  lg: "text-3xl md:text-4xl"
};
---

<div class="text-center space-y-4 md:space-y-6 pt-12 md:pt-20 pb-4 md:pb-8">
  {highlight && (
    <span class={`font-display text-brand font-bold uppercase tracking-widest drop-shadow-md ${highlightSizes[size]}`}>
      {highlight}
    </span>
  )}
  
  <h1 class={`font-display text-foreground font-light uppercase tracking-tight drop-shadow-lg ${titleSizes[size]}`}>
    {title}
  </h1>
  
  {subtitle && (
    <p class="text-foreground-muted text-sm md:text-base font-light leading-relaxed max-w-2xl mx-auto">
      {subtitle}
    </p>
  )}
</div>