---
// src/components/DesignSystem/SectionTitle.astro
const { title, level = 'h2', align = 'left' } = Astro.props;

const isCenter = align === 'center';
const baseClass = `font-avantgarde text-white text-xl md:text-2xl font-light uppercase tracking-wider mb-6 ${isCenter ? 'text-center mx-auto' : 'text-left'}`;
---

{level === 'h3' ? <h3 class={baseClass}>{title}</h3> : <h2 class={baseClass}>{title}</h2>}