---
interface Props {
  class?: string;
  hover?: 'orange' | 'white' | 'none';
  id?: string; // ✅ Añadido para los anclajes (#nombre-artista)
}

const { class: className = '', hover = 'orange', id } = Astro.props;

const baseClasses = "bg-white/5 border border-white/10 rounded-2xl overflow-hidden transition-all duration-300";
const hoverClasses = {
  orange: "hover:border-[rgb(233,157,56)]/50 hover:bg-white/[0.07]",
  white: "hover:border-white/30 hover:bg-white/10",
  none: ""
};

const finalClass = `${baseClasses} ${hoverClasses[hover]} ${className}`;
---

<div {id} class={finalClass}>
  <slot />
</div>