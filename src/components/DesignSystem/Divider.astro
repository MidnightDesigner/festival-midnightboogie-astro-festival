---
// src/components/DesignSystem/Divider.astro
// Propiedades opcionales con valores por defecto
const { 
  width = 'w-1/2', 
  color = 'bg-[rgb(233,157,56)]', 
  margin = 'my-8', 
  opacity = 'opacity-80' 
} = Astro.props;
---

<!-- El separador reutilizable -->
<div class={`h-[1px] ${color} mx-auto ${margin} ${opacity} ${width}`}></div>