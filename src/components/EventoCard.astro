---
// src/components/EventoCard.astro
import { artistas2026 } from '../data/artistas';
import { getSlug } from '../lib/getSlug';

export interface Props {
  evento: {
    hora: string;
    lugar: string;
    direccion: string;
    titulo: string;
    artistas?: Array<{
      nombre: string;
      origen?: string;
      estilo?: string;
    }>;
    descripcion?: string;
    precio: string;
    link?: string;
    linkTexto?: string;
  };
}

const { evento } = Astro.props;
const tieneArtistas = evento.artistas && evento.artistas.length > 0;
const tieneLink = evento.link && evento.link.trim() !== '';
const esFiestaPosterior = evento.titulo.toLowerCase().includes('fiesta posterior');

// Mapa: nombre exacto del lugar en los datos -> logo de la sala
const logoPorSala: Record<string, string> = {
  "Sala Arkabia": "/images/salas-logos/arkabia-BLACK.webp",
  "Helldorado": "/images/salas-logos/helldorado.png",
  "Ttipia Taberna": "/images/salas-logos/ttipia.webp",
  "Creative Soul": "/images/salas-logos/creative-soul.webp",
};
const logoSala = logoPorSala[evento.lugar];

// Crear mapa de artistas válidos de 2026 para mapear los enlaces del programa
const artistasValidos = new Map(
  artistas2026.map(a => [getSlug(a.nombre), a])
);




---

<div class="max-w-4xl mx-auto">
  <!-- Línea Naranja superior -->
  <div class="w-132 h-[1px] bg-white mx-auto mb-4 opacity-80"></div>
  
  <!-- Título del Evento -->
  <h3 class="font-avantgarde text-white text-sm md:text-xl font-light uppercase tracking-[0.2em] mb-4 drop-shadow-md text-center">
    {evento.titulo}
  </h3>
  
  <!-- Línea Naranja inferior -->
  <div class={`w-132 h-[1px] bg-white mx-auto opacity-80 ${esFiestaPosterior ? 'mb-6' : 'mb-12'}`}></div>

  {/* Lista de Artistas */}
  {tieneArtistas && (
    <ul class={`mx-auto ${esFiestaPosterior ? 'space-y-3 mb-8' : 'space-y-10 mb-16'}`}>
      {evento.artistas?.map((artista) => {
        const esDJ = artista.estilo?.toLowerCase().includes('dj');
        const slug = getSlug(artista.nombre);
        const tienePagina = artistasValidos.has(slug);
        return (
          <li class={`text-center last:border-0 last:pb-0 ${esFiestaPosterior ? 'border-b border-white/5 pb-3' : 'border-b border-white/10 pb-10'}`}>
            <h4 class={`font-avantgarde text-white font-light uppercase tracking-tight drop-shadow-2xl leading-tight px-4 
              ${esFiestaPosterior ? 'text-lg md:text-2xl text-white/80 mb-0.5' : (esDJ ? 'text-2xl md:text-2xl text-white/70 mb-3' : 'text-5xl sm:text-7xl md:text-8xl mb-3')}`}>
              {tienePagina ? (
                <a 
                  href={`/artistas#${slug}`} 
                  class="hover:text-[rgb(233,157,56)] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[rgb(233,157,56)]/50 rounded-lg transition-colors duration-300"
                  aria-label={`Ver biografía de ${artista.nombre}`}
                >
                  {artista.nombre}
                </a>
              ) : (
                artista.nombre
              )}
            </h4>
            
            {esDJ ? (
              <p class={`text-white/50 text-[10px] md:text-xs font-light uppercase tracking-wider ${esFiestaPosterior ? 'mb-0.5' : 'mb-2'}`}>
                {artista.origen ? `${artista.origen} · ` : ''}{artista.estilo}
              </p>
            ) : (
              <>
                {artista.origen && (
                  <p class="text-white/60 text-sm font-light uppercase tracking-[0.2em] mb-2">
                    {artista.origen}
                  </p>
                )}
                {artista.estilo && (
                  <p class="text-white/40 text-xs font-light italic">
                    {artista.estilo}
                  </p>
                )}
              </>
            )}
          </li>
        );
      })}
    </ul>
  )}

  {/* Descripción (solo para el taller) */}
  {evento.descripcion && (
    <div class="max-w-2xl mx-auto mb-12">
      <p class="text-white/70 text-sm md:text-base font-light leading-relaxed text-center">
        {evento.descripcion}
      </p>
    </div>
  )}

  {/* Info de Sala, Hora y Dirección */}
  {/* Logo de la sala (si tiene) */}
{logoSala && (
  <div class={`flex justify-center ${esFiestaPosterior ? 'mb-2' : 'mb-4'}`}>
    <img 
      src={logoSala} 
      alt={`Logo de ${evento.lugar}`} 
      class={`w-auto object-contain ${esFiestaPosterior ? 'h-10 md:h-14' : 'h-14 md:h-20'}`}
      loading="lazy"
    />
  </div>
)}
  <div class={`flex flex-col md:flex-row justify-center items-center gap-2 md:gap-4 text-white ${esFiestaPosterior ? 'mb-4 text-sm' : 'mb-10'}`}>
    <span class={`font-bold uppercase tracking-wider ${esFiestaPosterior ? 'text-base' : 'text-xl'}`}>{evento.lugar}</span>
    <span class="hidden md:block w-1.5 h-1.5 bg-white/30 rounded-full"></span>
    <time class={`text-[rgb(233,157,56)] font-bold ${esFiestaPosterior ? 'text-base' : 'text-xl'}`}>{evento.hora}h</time>
    <span class="hidden md:block w-1.5 h-1.5 bg-white/30 rounded-full"></span>
    <span class={`text-white/70 font-light tracking-wide ${esFiestaPosterior ? 'text-xs' : 'text-sm'}`}>{evento.direccion}</span>
  </div>

  {/* Precio y Botón con icono de enlace externo */}
  <div class={`flex flex-col justify-center items-center ${esFiestaPosterior ? 'gap-1 mb-4' : 'gap-4 mb-8'}`}>
    <span class={`text-white font-light tracking-wide whitespace-nowrap text-center ${esFiestaPosterior ? 'text-xs sm:text-lg text-white/80' : 'text-sm sm:text-2xl'}`}>
      {evento.precio}
    </span>
    
    {tieneLink && (
      <a 
        href={evento.link} 
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 bg-[rgb(233,157,56)] text-black px-4 py-1.5 sm:px-8 sm:py-3 rounded-full text-[10px] sm:text-sm font-bold uppercase tracking-widest hover:bg-white transition-colors shadow-lg whitespace-nowrap text-center"
      >
        {evento.linkTexto || 'Comprar Entrada'}
        <!-- Icono de enlace externo -->
        <svg 
          xmlns="http://www.w3.org/2000/svg" 
          fill="none" 
          viewBox="0 0 24 24" 
          stroke-width="2" 
          stroke="currentColor" 
          class="w-3 h-3 sm:w-4 sm:h-4"
        >
          <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 6H5.25A2.25 2.25 0 003 8.25v10.5A2.25 2.25 0 005.25 21h10.5A2.25 2.25 0 0018 18.75V10.5m-10.5 6L21 3m0 0h-5.25M21 3v5.25" />
        </svg>
      </a>
    )}
  </div>
</div>