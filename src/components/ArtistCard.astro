---
// src/components/ArtistCard.astro
import type { Artista } from '../data/artistas';
import { Image } from 'astro:assets';

export interface Props {
  artista: Artista;
}

const { artista } = Astro.props;
const extractoBio = artista.biografia[0];
const bioCompleta = artista.biografia.slice(1);
const tieneWeb = artista.web && artista.web.trim() !== '';

function getYoutubeId(url: string): string | null {
  if (!url) return null;
  const regex = /(?:youtube\.com\/(?:watch\?v=|embed\/|v\/|shorts\/)|youtu\.be\/)([^&?\n\/]+)/;
  const match = url.match(regex);
  return match ? match[1] : null;
}

const youtubeId = tieneWeb ? getYoutubeId(artista.video || '') : null;
const tieneVideo = youtubeId !== null;
---

<article class="artist-card mx-auto bg-white/5 border border-white/10 rounded-2xl overflow-hidden hover:border-[rgb(233,157,56)]/40 transition-colors duration-500">
  
  <!-- BLOQUE SUPERIOR: TÍTULO Y ORIGEN -->
  <div class="px-8 md:px-16 pt-12 md:pt-16 pb-8 md:pb-12 text-center">
    <h3 class="font-avantgarde text-white text-4xl md:text-6xl font-light uppercase tracking-tight mb-4 drop-shadow-lg group-hover:text-[rgb(233,157,56)] transition-colors duration-300">
      {artista.nombre}
    </h3>
    <p class="text-white/60 text-[11px] md:text-sm font-light uppercase tracking-[0.25em]">
      {artista.origen} <span class="mx-2 text-[rgb(233,157,56)]">·</span> {artista.estilo}
    </p>
  </div>

  <!-- BLOQUE CENTRAL: FOTOGRAFÍA (clicable para lightbox) -->
  <div class="w-full">
    <button 
      class="lightbox-trigger w-full aspect-[16/9] md:aspect-[2/1] overflow-hidden flex items-center justify-center cursor-pointer relative group"
      aria-label={`Ver foto de ${artista.nombre} a pantalla completa`}
    >
      <Image 
        src={artista.imagen} 
        alt={`Foto de ${artista.nombre}`}
        class="w-full h-full object-contain group-hover:scale-105 transition-transform duration-700 ease-out"
        loading="lazy"
        width={1200}
        height={675}
        format="webp"
        quality={80}
      />
      <!-- Icono de lupa al hacer hover -->
      <div class="absolute inset-0 bg-black/0 group-hover:bg-black/30 transition-colors duration-300 flex items-center justify-center">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-12 h-12 text-white opacity-0 group-hover:opacity-100 transition-opacity duration-300">
          <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-5.197-5.197m0 0A7.5 7.5 0 105.196 5.196a7.5 7.5 0 0010.607 10.607zM10.5 7.5v6m3-3h-6" />
        </svg>
      </div>
    </button>
  </div>

  <!-- BLOQUE INFERIOR: BIOGRAFÍA EXPANDIBLE -->
  <div class="px-8 md:px-16 pt-12 md:pt-16 pb-12 md:pb-16 text-center">
    
    <!-- Extracto (siempre visible) -->
    <p class="text-white/70 text-sm md:text-base font-light leading-relaxed mb-6">
      {extractoBio}
    </p>

    <!-- Biografía Completa (OCULTA por defecto) -->
    <div class="bio-completa">
      <div class="space-y-4 mb-8">
        {bioCompleta.map((parrafo) => (
          <p class="text-white/70 text-sm md:text-base font-light leading-relaxed">
            {parrafo}
          </p>
        ))}
      </div>

      <!-- Enlace a la Web Oficial (solo si existe) -->
      {tieneWeb && (
        <div class="pt-8 mt-8 border-t border-white/10">
          <p class="text-white/50 text-[10px] md:text-xs font-light uppercase tracking-[0.25em] mb-3">
            Web Oficial
          </p>
          <a 
            href={artista.web}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex flex-wrap items-center justify-center gap-2 text-[rgb(233,157,56)] text-[10px] md:text-sm font-bold uppercase tracking-[0.15em] md:tracking-[0.2em] border-b border-[rgb(233,157,56)] pb-1 hover:text-white hover:border-white transition-colors duration-300 max-w-full"
          >
            <span class="truncate">
              {artista.web.replace(/^https?:\/\//, '').replace(/\/$/, '')}
            </span>
            <svg 
              xmlns="http://www.w3.org/2000/svg" 
              fill="none" 
              viewBox="0 0 24 24" 
              stroke-width="1.5" 
              stroke="currentColor" 
              class="w-4 h-4 flex-shrink-0"
            >
              <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 6H5.25A2.25 2.25 0 003 8.25v10.5A2.25 2.25 0 005.25 21h10.5A2.25 2.25 0 0018 18.75V10.5m-10.5 6L21 3m0 0h-5.25M21 3v5.25" />
            </svg>
          </a>
        </div>
      )}

      <!-- VÍDEO OFICIAL (solo si existe y es YouTube válido) -->
      {tieneVideo && (
        <div class="pt-8 mt-8 border-t border-white/10">
          <p class="text-white/50 text-[10px] md:text-xs font-light uppercase tracking-[0.25em] mb-4">
            Vídeo
          </p>
          <div class="relative w-full aspect-video rounded-lg overflow-hidden bg-black shadow-2xl">
            <iframe
              src={`https://www.youtube.com/embed/${youtubeId}`}
              title={`Vídeo de ${artista.nombre}`}
              class="absolute inset-0 w-full h-full"
              frameborder="0"
              allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
              allowfullscreen
              loading="lazy"
            ></iframe>
          </div>
        </div>
      )}
    </div>

    <!-- Botón Toggle con Flecha -->
    <button 
      class="bio-toggle inline-flex items-center gap-2 text-[rgb(233,157,56)] text-xs md:text-sm font-bold uppercase tracking-[0.2em] border-b border-[rgb(233,157,56)] pb-1 hover:text-white hover:border-white transition-colors duration-300 mt-12"
      aria-expanded="false"
    >
      <span class="toggle-text">Ver biografía completa</span>
      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-4 h-4 transition-transform duration-300 arrow-icon">
        <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5" />
      </svg>
    </button>
  </div>

     <!-- LIGHTBOX MODAL (clic en cualquier parte para cerrar) -->
  <div 
    class="lightbox-modal fixed inset-0 z-[200] hidden cursor-pointer"
    role="dialog"
    aria-modal="true"
    aria-label={`Foto de ${artista.nombre}`}
  >
    <!-- Overlay clicable -->
    <div class="lightbox-overlay absolute inset-0 bg-black/95 backdrop-blur-sm"></div>
    
    <!-- Imagen -->
    <div class="absolute inset-0 flex items-center justify-center p-4">
      <img 
        src={artista.imagen} 
        alt={`Foto de ${artista.nombre}`}
        class="lightbox-image w-auto h-auto max-w-[95vw] max-h-[90vh] object-contain"
      />
    </div>
  </div>

</article>

<style>
  .artist-card {
    width: 92vw;
  }
  
  @media (min-width: 768px) {
    .artist-card {
      width: 70vw;
    }
  }

  .bio-completa {
    max-height: 0;
    overflow: hidden;
    opacity: 0;
    transition: max-height 0.5s ease-in-out, opacity 0.3s ease-in-out;
  }

  .bio-completa.expanded {
    max-height: 3000px;
    opacity: 1;
  }

  .bio-toggle[aria-expanded="true"] .arrow-icon {
    transform: rotate(180deg);
  }

  /* Lightbox animations */
  .lightbox-modal.active {
    display: flex;
    animation: fadeIn 0.3s ease-out;
  }

  .lightbox-modal.active .lightbox-image {
    animation: zoomIn 0.3s ease-out;
  }

  @keyframes fadeIn {
    from { opacity: 0; }
    to { opacity: 1; }
  }

  @keyframes zoomIn {
    from { 
      opacity: 0;
      transform: scale(0.9);
    }
    to { 
      opacity: 1;
      transform: scale(1);
    }
  }

  body.lightbox-open {
    overflow: hidden;
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    // Toggle de biografía
    const toggleButtons = document.querySelectorAll('.bio-toggle');
    
    toggleButtons.forEach(button => {
      button.addEventListener('click', () => {
        const card = button.closest('.artist-card');
        const bioCompleta = card.querySelector('.bio-completa');
        const toggleText = button.querySelector('.toggle-text');
        const isExpanded = button.getAttribute('aria-expanded') === 'true';
        
        button.setAttribute('aria-expanded', !isExpanded);
        bioCompleta.classList.toggle('expanded');
        
        toggleText.textContent = isExpanded ? 'Ver biografía completa' : 'Ocultar biografía';
      });
    });

    // Lightbox functionality
    const lightboxTriggers = document.querySelectorAll('.lightbox-trigger');
    
    lightboxTriggers.forEach(trigger => {
      trigger.addEventListener('click', () => {
        const card = trigger.closest('.artist-card');
        const modal = card.querySelector('.lightbox-modal');

        const openLightbox = () => {
          modal?.classList.add('active');
          document.body.classList.add('lightbox-open');
        };

        const closeLightbox = () => {
          modal?.classList.remove('active');
          document.body.classList.remove('lightbox-open');
        };

        openLightbox();

        // Cerrar al hacer clic en cualquier parte del modal
        modal?.addEventListener('click', closeLightbox);

        // Cerrar con tecla Escape
        const handleEscape = (e: KeyboardEvent) => {
          if (e.key === 'Escape' && modal?.classList.contains('active')) {
            closeLightbox();
            document.removeEventListener('keydown', handleEscape);
          }
        };
        document.addEventListener('keydown', handleEscape);
      });
    });
  });
</script>