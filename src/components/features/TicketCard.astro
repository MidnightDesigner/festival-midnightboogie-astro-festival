---
import type { Entrada } from '../../data/entradas';
import Button from '../ui/Button.astro';
import TextMeta from '../ui/TextMeta.astro';
import Card from '../ui/Card.astro';
import Divider from '../ui/Divider.astro';
import { useTranslations, type Locale } from '../../i18n';

export interface Props {
  entrada: Entrada;
}

const { entrada } = Astro.props;
const lang = (Astro.currentLocale || 'es') as Locale;
const t = useTranslations(lang);

const estadoColors: Record<string, string> = {
  "Disponibles": "bg-success/30 text-success border-success/50",
  "Últimas entradas": "bg-brand/30 text-brand border-brand/50",
  "Entradas agotadas": "bg-error/30 text-error border-error/50"
};

const logoPorSala: Record<string, string> = {
  "Sala Arkabia": "/images/salas-logos/arkabia-BLACK.webp",
  "Arkabia Aretoa": "/images/salas-logos/arkabia-BLACK.webp",
  "Helldorado": "/images/salas-logos/helldorado.png",
  "Ttipia": "/images/salas-logos/ttipia.webp",
  "Ttipia Taberna": "/images/salas-logos/ttipia.webp",
  "Creative Soul": "/images/salas-logos/creative-soul.webp",
};

const logoSala = Object.entries(logoPorSala).find(([sala]) =>
  entrada.lugar.startsWith(sala)
)?.[1];

const mapUrl = entrada.direccion
  ? `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(entrada.direccion + ", Vitoria-Gasteiz")}`
  : null;

const estadoTraducido = entrada.estado === "Disponibles" 
  ? t('ticket.available') 
  : entrada.estado === "Últimas entradas" 
    ? t('ticket.last')
    : entrada.estado === "Entradas agotadas"
      ? t('ticket.soldOut')
      : entrada.estado;
---

<Card class="mx-auto w-[90vw] md:w-[64vw] mb-8 md:mb-12" hover="orange">
  <div class="p-6 md:p-8">
    <div class="mb-4">
      <TextMeta variant="date" text={`${entrada.fecha} · ${entrada.hora}`} />
    </div>

    <h3 class="font-display text-foreground-muted text-sm md:text-base font-light uppercase tracking-widest mb-2">
      {entrada.evento}
    </h3>

    <h2 class="font-display text-foreground text-3xl md:text-5xl font-light uppercase tracking-tight mb-6 drop-shadow-lg">
      {entrada.artista}
    </h2>

    <Divider width="w-full" color="bg-border" margin="my-4" />

    {logoSala && (
      <div class="flex mb-6">
        <img 
          src={logoSala} 
          alt={`Logo de ${entrada.lugar}`} 
          class="h-14 md:h-20 w-auto object-contain"
          loading="lazy"
        />
      </div>
    )}

    {entrada.direccion ? (
      <a 
        href={mapUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="flex items-start gap-3 mb-6 group/lugar w-fit"
        aria-label={t('ticket.viewOnMaps').replace('{venue}', entrada.lugar)}
      >
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5 text-brand mt-0.5 flex-shrink-0 group-hover/lugar:scale-110 transition-transform">
          <path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z" />
          <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z" />
        </svg>
        
        <div class="flex flex-col gap-1.5">
          <TextMeta variant="venue-name" text={entrada.lugar} />
          <TextMeta variant="venue-address" text={entrada.direccion} />
        </div>
      </a>
    ) : (
      <div class="flex items-start gap-3 mb-6">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5 text-brand mt-0.5 flex-shrink-0">
          <path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z" />
          <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z" />
        </svg>
        <TextMeta variant="venue-name" text={entrada.lugar} />
      </div>
    )}

    <div class="mb-6">
      <TextMeta 
        variant="badge" 
        text={estadoTraducido} 
        class={estadoColors[entrada.estado] || "bg-surface text-foreground-muted border-border"} 
      />
    </div>

    {entrada.precioTaquilla ? (
      <div class="flex items-center mb-6 gap-12">
        <div>
          <TextMeta variant="tag" text={t('ticket.advance')} />
          <TextMeta variant="price" text={entrada.precioAnticipada} />
        </div>
        <div>
          <TextMeta variant="tag" text={t('ticket.boxOffice')} />
          <TextMeta variant="price" text={entrada.precioTaquilla} />
        </div>
      </div>
    ) : (
      <div class="mb-6">
        <TextMeta variant="tag" text={t('ticket.advance')} />
        <TextMeta variant="price" text={entrada.precioAnticipada} />
      </div>
    )}

    {entrada.estado !== "Entradas agotadas" ? (
      <Button href={entrada.link} variant="primary" class="w-full md:w-auto gap-2">
        {entrada.linkTexto || t('ticket.buy')}
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-4 h-4">
          <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 6H5.25A2.25 2.25 0 003 8.25v10.5A2.25 2.25 0 005.25 21h10.5A2.25 2.25 0 0018 18.75V10.5m-10.5 6L21 3m0 0h-5.25M21 3v5.25" />
        </svg>
      </Button>
    ) : (
      <button disabled class="inline-flex items-center justify-center gap-2 w-full md:w-auto bg-surface text-foreground-disabled border border-border px-8 py-3 rounded-button text-sm font-bold uppercase tracking-widest cursor-not-allowed">
        {t('ticket.soldOut')}
      </button>
    )}
  </div>
</Card>