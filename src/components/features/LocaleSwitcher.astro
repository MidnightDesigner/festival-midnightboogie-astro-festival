---
import { getRelativeLocaleUrl } from 'astro:i18n';
import { locales, defaultLocale } from '../../i18n';

interface Props {
  variant?: 'dropdown' | 'inline';
}
const { variant = 'inline' } = Astro.props;

const currentLocale = Astro.currentLocale || defaultLocale;

function stripLocale(pathname) {
  for (const l of locales) {
    if (l === defaultLocale) continue;
    if (pathname === `/${l}` || pathname === `/${l}/`) return '/';
    if (pathname.startsWith(`/${l}/`)) return pathname.slice(`/${l}`.length);
  }
  return pathname;
}

const basePath = stripLocale(Astro.url.pathname);
const cleanPath = basePath === '/' ? '' : basePath.replace(/\/+$/, '');
const hrefFor = (locale) => getRelativeLocaleUrl(locale, cleanPath);

const labels = { es: 'ES', eu: 'EU', en: 'EN', fr: 'FR' };
const otherLocales = locales.filter((l) => l !== currentLocale);
---

{variant === 'dropdown' ? (
  <div class="relative group">
    <button
      type="button"
      class="flex items-center gap-1.5 text-[11px] font-bold uppercase tracking-widest text-black px-1 py-0.5 cursor-default"
      aria-haspopup="true"
    >
      {labels[currentLocale] ?? currentLocale.toUpperCase()}
      <svg class="w-3 h-3 transition-transform duration-200 group-hover:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
        <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5" />
      </svg>
    </button>

    <div class="absolute right-0 top-full pt-2 opacity-0 invisible group-hover:visible group-hover:opacity-100 group-focus-within:visible group-focus-within:opacity-100 transition-all duration-200 z-50">
      <div class="bg-brand border border-brand-border rounded-lg shadow-lg flex flex-col min-w-[64px] overflow-hidden">
        {otherLocales.map((locale) => (
          <a
            href={hrefFor(locale)}
            hreflang={locale}
            lang={locale}
            class="text-[11px] font-bold uppercase tracking-widest text-black/80 hover:text-black hover:bg-brand-border/40 px-3 py-2 text-center transition-colors"
          >
            {labels[locale] ?? locale.toUpperCase()}
          </a>
        ))}
      </div>
    </div>
  </div>
) : (
  <nav class="locale-switcher flex items-center" aria-label="Selector de idioma">
    {locales.map((locale, i) => {
      const isActive = locale === currentLocale;
      return (
        <>
          {i > 0 && <span class="text-black/50 text-[10px] select-none mx-0.5">·</span>}
          <a
            href={hrefFor(locale)}
            hreflang={locale}
            lang={locale}
            aria-current={isActive ? 'page' : undefined}
            class:list={[
              'text-[11px] font-bold uppercase tracking-widest px-1 py-0.5 transition-colors',
             isActive ? 'text-black border-b border-black' : 'text-black/70 hover:text-black'
            ]}
          >
            {labels[locale] ?? locale.toUpperCase()}
          </a>
        </>
      );
    })}
  </nav>
)}