---



import type { Artista } from '../../data/artistas.ts';
import { Image } from 'astro:assets';
import { getSlug } from '../../lib/getSlug';
import TextMeta from '../ui/TextMeta.astro';
import Card from '../ui/Card.astro';
import { useTranslations, type Locale } from '../../i18n';

export interface Props {
  artista: Artista;
}

const { artista } = Astro.props;
const lang = (Astro.currentLocale || 'es') as Locale;
const t = useTranslations(lang);

const extractoBio = artista.biografia?.[0] ?? '';
const bioCompleta = artista.biografia?.slice(1) ?? [];
const tieneWeb = artista.web && artista.web.trim() !== '';

function getYoutubeId(url: string): string | null {
  if (!url) return null;
  const regex = /(?:youtube\.com\/(?:watch\?v=|embed\/|v\/|shorts\/)|youtu\.be\/)([^&?\n\/]+)/;
  const match = url.match(regex);
  return match ? match[1] : null;
}

const youtubeId = tieneWeb ? getYoutubeId(artista.video || '') : null;
const tieneVideo = youtubeId !== null;
const artistId = getSlug(artista.nombre);
---

<Card id={artistId} class="artist-card scroll-mt-28 md:scroll-mt-40 mx-auto w-[92vw] md:w-[70vw] mb-8 md:mb-12" hover="none">
  <div class="px-6 md:px-12 lg:px-16 pt-10 md:pt-14 pb-6 md:pb-10 text-center">
    <h3 class="font-display text-foreground text-3xl md:text-5xl font-light uppercase tracking-tight mb-4 drop-shadow-lg">
      {artista.nombre}
    </h3>
    <TextMeta variant="meta" text={`${artista.origen} · ${artista.estilo}`} class="justify-center" />
  </div>

  <div class="w-full">
    <button 
      class="lightbox-trigger w-full aspect-[16/9] md:aspect-[2/1] overflow-hidden flex items-center justify-center cursor-pointer relative group bg-surface"
      aria-label={t('artist.viewPhoto').replace('{name}', artista.nombre)}
    >
      <Image 
        src={artista.imagen} 
        alt={t('artist.photoOf').replace('{name}', artista.nombre)}
        class="w-full h-full object-contain group-hover:scale-105 transition-transform duration-700 ease-out"
        loading="lazy"
        width={1200}
        height={675}
        format="webp"
        quality={80}
      />
      <div class="absolute inset-0 bg-transparent group-hover:bg-overlay-light transition-colors duration-300 flex items-center justify-center">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-12 h-12 text-foreground opacity-0 group-hover:opacity-100 transition-opacity duration-300">
          <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-5.197-5.197m0 0A7.5 7.5 0 105.196 5.196a7.5 7.5 0 0010.607 10.607zM10.5 7.5v6m3-3h-6" />
        </svg>
      </div>
    </button>
  </div>

  <div class="px-6 md:px-12 lg:px-16 pt-10 md:pt-14 pb-10 md:pb-14 text-center">
    <p class="text-foreground-muted text-sm md:text-base font-light leading-relaxed mb-6">
      {extractoBio}
    </p>

    <div class="bio-completa">
      <div class="bio-inner">
        <div class="space-y-4 mb-8 text-left md:text-center">
          {bioCompleta.map((parrafo) => (
            <p class="text-foreground-muted text-sm md:text-base font-light leading-relaxed">
              {parrafo}
            </p>
          ))}
        </div>

        {tieneWeb && (
          <div class="pt-8 mt-8 border-t border-border">
            <TextMeta variant="meta" text={t('artist.officialWeb')} class="justify-center mb-4" />
            <a 
              href={artista.web}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex flex-wrap items-center justify-center gap-2 text-brand text-sm md:text-base font-medium uppercase tracking-wider hover:text-foreground transition-all duration-300 max-w-full mx-auto"
            >
              <span class="truncate">
                {artista.web.replace(/^https?:\/\//, '').replace(/\/$/, '')}
              </span>
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-4 h-4 flex-shrink-0">
                <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 6H5.25A2.25 2.25 0 003 8.25v10.5A2.25 2.25 0 005.25 21h10.5A2.25 2.25 0 0018 18.75V10.5m-10.5 6L21 3m0 0h-5.25M21 3v5.25" />
              </svg>
            </a>
          </div>
        )}

        {tieneVideo && (
          <div class="pt-8 mt-8 border-t border-border">
            <TextMeta variant="meta" text={t('artist.video')} class="justify-center mb-4" />
            <div class="relative w-full aspect-video rounded-card overflow-hidden bg-background shadow-2xl">
              <iframe
                src={`https://www.youtube.com/embed/${youtubeId}`}
                title={`${t('artist.video')} - ${artista.nombre}`}
                class="absolute inset-0 w-full h-full"
                frameborder="0"
                allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                allowfullscreen
                loading="lazy"
              ></iframe>
            </div>
          </div>
        )}
      </div>
    </div>

    <button 
      class="bio-toggle inline-flex items-center gap-2 text-brand text-xs md:text-sm font-medium uppercase tracking-widest hover:text-foreground transition-colors duration-300 mt-8 mx-auto cursor-pointer focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand/50 rounded-lg px-2 py-1"
      aria-expanded="false"
      data-show={t('artist.showBio')}
      data-hide={t('artist.hideBio')}
    >
      <span class="toggle-text">{t('artist.showBio')}</span>
      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-4 h-4 transition-transform duration-300 arrow-icon">
        <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5" />
      </svg>
    </button>
  </div>

  <div class="lightbox-modal fixed inset-0 z-[200] hidden cursor-pointer" role="dialog" aria-modal="true" aria-label={t('artist.photoOf').replace('{name}', artista.nombre)}>
    <div class="lightbox-overlay absolute inset-0 bg-surface-overlay backdrop-blur-sm"></div>
    <div class="absolute inset-0 flex items-center justify-center p-4">
      <img src={artista.imagen} alt={t('artist.photoOf').replace('{name}', artista.nombre)} class="lightbox-image w-auto h-auto max-w-[95vw] max-h-[90vh] object-contain rounded-card shadow-2xl" />
    </div>
  </div>
</Card>

<style>
  .bio-completa {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 0.5s ease-out;
  }
  
  .bio-completa .bio-inner {
    overflow: hidden;
  }

  .bio-completa.expanded {
    grid-template-rows: 1fr;
  }

  .bio-toggle[aria-expanded="true"] .arrow-icon {
    transform: rotate(180deg);
  }

  .lightbox-modal.active { 
    display: flex; 
    animation: fadeIn 0.3s ease-out; 
  }
  
  .lightbox-modal.active .lightbox-image { 
    animation: zoomIn 0.3s ease-out; 
  }
  
  @keyframes fadeIn { 
    from { opacity: 0; } 
    to { opacity: 1; } 
  }
  
  @keyframes zoomIn { 
    from { opacity: 0; transform: scale(0.9); } 
    to { opacity: 1; transform: scale(1); } 
  }
  
  body.lightbox-open { 
    overflow: hidden; 
  }
</style>

<script>
  document.addEventListener('click', (e) => {
    const toggleButton = (e.target as HTMLElement).closest('.bio-toggle');
    if (toggleButton) {
      const card = toggleButton.closest('.artist-card');
      const bioContent = card?.querySelector('.bio-completa');
      const toggleText = toggleButton.querySelector('.toggle-text');
      const showText = toggleButton.getAttribute('data-show') || '';
      const hideText = toggleButton.getAttribute('data-hide') || '';
      const isCurrentlyExpanded = bioContent?.classList.contains('expanded');

      if (isCurrentlyExpanded) {
        bioContent?.classList.remove('expanded');
        toggleButton.setAttribute('aria-expanded', 'false');
        if (toggleText) toggleText.textContent = showText;
      } else {
        bioContent?.classList.add('expanded');
        toggleButton.setAttribute('aria-expanded', 'true');
        if (toggleText) toggleText.textContent = hideText;
      }
      return;
    }

    const trigger = (e.target as HTMLElement).closest('.lightbox-trigger');
    if (trigger) {
      const card = trigger.closest('.artist-card');
      const modal = card?.querySelector('.lightbox-modal');
      modal?.classList.add('active');
      document.body.classList.add('lightbox-open');
      return;
    }

    const modalActivo = document.querySelector('.lightbox-modal.active');
    if (modalActivo && modalActivo.contains(e.target as Node)) {
      modalActivo.classList.remove('active');
      document.body.classList.remove('lightbox-open');
    }
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') {
      const modal = document.querySelector('.lightbox-modal.active');
      if (modal) {
        modal.classList.remove('active');
        document.body.classList.remove('lightbox-open');
      }
    }
  });
</script>