---
// src/components/TicketCard.astro
import type { Entrada } from '../data/entradas';

export interface Props {
  entrada: Entrada;
}

const { entrada } = Astro.props;

const estadoColors = {
  "Disponible": "bg-green-500/20 text-green-400 border-green-500/30",
  "Últimas entradas": "bg-[rgb(233,157,56)]/20 text-[rgb(233,157,56)] border-[rgb(233,157,56)]/30",
  "Agotado": "bg-red-500/20 text-red-400 border-red-500/30"
};
---

<article class="ticket-card mx-auto bg-white/5 border border-white/10 rounded-2xl overflow-hidden hover:border-[rgb(233,157,56)]/40 transition-colors duration-500 mb-8 md:mb-12">
  
  <div class="p-6 md:p-8">
    
    <!-- Cabecera: Fecha -->
    <div class="mb-4">
      <span class="text-[rgb(233,157,56)] text-sm md:text-base font-bold uppercase tracking-[0.2em]">
        {entrada.fecha} · {entrada.hora}
      </span>
    </div>

    <!-- EVENTO -->
    <h3 class="font-avantgarde text-white/70 text-sm md:text-base font-light uppercase tracking-[0.2em] mb-2">
      {entrada.evento}
    </h3>

    <!-- ARTISTA -->
    <h2 class="font-avantgarde text-white text-3xl md:text-5xl font-light uppercase tracking-tight mb-6 drop-shadow-lg">
      {entrada.artista}
    </h2>

    <!-- Línea separadora -->
    <div class="w-full h-[1px] bg-white/10 my-4"></div>

    <!-- Lugar -->
    <div class="flex items-start gap-3 mb-4">
      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5 text-[rgb(233,157,56)] mt-0.5 flex-shrink-0">
        <path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z" />
        <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z" />
      </svg>
      <span class="text-white/80 text-sm md:text-base font-light leading-relaxed">
        {entrada.lugar}
      </span>
    </div>

    <!-- Badge de Estado -->
    <div class="mb-6">
      <span class={`inline-flex items-center px-4 py-2 rounded-full text-[10px] md:text-xs font-bold uppercase tracking-widest border ${estadoColors[entrada.estado]}`}>
        {entrada.estado}
      </span>
    </div>

    <!-- Precios -->
    {entrada.precioTaquilla && (
      <div class="flex items-center mb-6" style="gap: 48px;">
        <div>
          <span class="text-white/50 text-sm font-light uppercase tracking-wider">Anticipada: </span>
          <span class="text-white text-xl md:text-2xl font-light tracking-tight">
            {entrada.precioAnticipada}
          </span>
        </div>
        <div>
          <span class="text-white/50 text-sm font-light uppercase tracking-wider">Taquilla: </span>
          <span class="text-white text-xl md:text-2xl font-light tracking-tight">
            {entrada.precioTaquilla}
          </span>
        </div>
      </div>
    )}

    {!entrada.precioTaquilla && (
      <div class="mb-6">
        <span class="text-white/50 text-sm font-light uppercase tracking-wider">Anticipada: </span>
        <span class="text-white text-xl md:text-2xl font-light tracking-tight">
          {entrada.precioAnticipada}
        </span>
      </div>
    )}

    <!-- Botón de Acción -->
    {entrada.estado !== "Agotado" ? (
      <a 
        href={entrada.link}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center justify-center gap-2 w-full md:w-auto bg-[rgb(233,157,56)] text-black px-8 py-3 rounded-full text-sm font-bold uppercase tracking-widest hover:bg-white transition-colors duration-300 shadow-lg"
      >
        {entrada.linkTexto}
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-4 h-4">
          <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 6H5.25A2.25 2.25 0 003 8.25v10.5A2.25 2.25 0 005.25 21h10.5A2.25 2.25 0 0018 18.75V10.5m-10.5 6L21 3m0 0h-5.25M21 3v5.25" />
        </svg>
      </a>
    ) : (
      <button disabled class="inline-flex items-center justify-center gap-2 w-full md:w-auto bg-white/10 text-white/40 px-8 py-3 rounded-full text-sm font-bold uppercase tracking-widest cursor-not-allowed">
        Entradas Agotadas
      </button>
    )}

  </div>
</article>

<style>
  .ticket-card {
    width: 90vw;
  }

  @media (min-width: 768px) {
    .ticket-card {
      width: 64vw;
    }
  }
</style>