---
// src/pages/contacto.astro
import Layout from '../layouts/Layout.astro';

const contactInfo = [
  {
    icon: `<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-6 h-6"><path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75" /></svg>`,
    title: "Información General",
    detail: "info@midnightboogie.net",
    link: "mailto:info@midnightboogie.net"
  },
  {
    icon: `<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-6 h-6"><path stroke-linecap="round" stroke-linejoin="round" d="M12 7.5h1.5m-1.5 3h1.5m-7.5 3h7.5m-7.5 3h7.5m3-9h3.375c.621 0 1.125.504 1.125 1.125V18a2.25 2.25 0 01-2.25 2.25M16.5 7.5V18a2.25 2.25 0 002.25 2.25M16.5 7.5V4.875c0-.621-.504-1.125-1.125-1.125H4.125C3.504 3.75 3 4.254 3 4.875V18a2.25 2.25 0 002.25 2.25h13.5M6 7.5h3v3H6v-3z" /></svg>`,
    title: "Prensa y Patrocinios",
    detail: "info@midnightboogie.net",
    link: "mailto:info@midnightboogie.net"
  }
];

const ubicaciones = [
  {
    nombre: "Sala Arkabia",
    direccion: "Postas 13-15, Vitoria-Gasteiz",
    evento: "Concierto de Presentación · Septiembre",
    maps: "https://maps.app.goo.gl/z98wijNCT9BhRG7E8"
  },
  {
    nombre: "Ttipia Taberna",
    direccion: "Zapatería 94, Vitoria-Gasteiz",
    evento: "Fiesta Posterior",
    maps: "https://maps.app.goo.gl/sbTHfNWDRANJksH28"
  },
  {
    nombre: "Helldorado",
    direccion: "Venta de la Estrella, 6 Pab. 44, Vitoria-Gasteiz",
    evento: "Conciertos de Noviembre · Viernes y Sábado",
    maps: "https://maps.app.goo.gl/GQKDK7qJDeTEd62e7"
  },
  {
    nombre: "Creative Soul",
    direccion: "Pintor Pablo Uranga Kalea 22, Vitoria-Gasteiz",
    evento: "Taller Familiar · Sábado Noviembre",
    maps: "https://maps.app.goo.gl/8NuYzMiBojJNHz1z9"
  }
];
---

<Layout 
  title="Contacto y Prensa" 
  description="Ponte en contacto con el equipo del Midnight Boogie Festival."
>
  <section class="max-w-6xl mx-auto px-6 py-16 md:py-24 relative z-10">
    
    <div class="text-center mb-16">
      <h1 class="font-avantgarde text-white text-4xl md:text-6xl font-light uppercase tracking-tight mb-6 drop-shadow-lg">
        Hablemos
      </h1>
      <p class="text-white/70 text-sm md:text-base font-light max-w-2xl mx-auto leading-relaxed">
        ¿Tienes dudas sobre las entradas, eres prensa o quieres proponer una colaboración? 
        Estamos aquí para ayudarte.
      </p>
      <div class="w-24 h-[1px] bg-[rgb(233,157,56)] mx-auto mt-8 opacity-80"></div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-12 md:gap-16">
      <div class="space-y-8">
        {contactInfo.map((item) => (
          <a 
            href={item.link} 
            target={item.link.startsWith("http") ? "_blank" : "_self"}
            rel="noopener noreferrer"
            class="flex items-start gap-4 group p-4 rounded-xl hover:bg-white/5 transition-colors duration-300"
          >
            <div class="text-[rgb(233,157,56)] mt-1 group-hover:scale-110 transition-transform duration-300" set:html={item.icon}></div>
            <div>
              <h3 class="font-avantgarde text-white text-lg font-light uppercase tracking-wider mb-1">
                {item.title}
              </h3>
              <p class="text-white/60 text-sm font-light group-hover:text-white transition-colors">
                {item.detail}
              </p>
            </div>
          </a>
        ))}

        <div class="w-full h-[1px] bg-white/10 my-4"></div>

        <div>
          <h3 class="font-avantgarde text-white text-lg font-light uppercase tracking-wider mb-4 flex items-center gap-3">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5 text-[rgb(233,157,56)]">
              <path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z" />
              <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z" />
            </svg>
            Ubicaciones del Festival
          </h3>

          <div class="space-y-3">
            {ubicaciones.map((ubi) => (
              <a 
                href={ubi.maps} 
                target="_blank" 
                rel="noopener noreferrer"
                class="flex items-start gap-4 group p-4 rounded-xl hover:bg-white/5 transition-colors duration-300"
              >
                <div class="w-2 h-2 rounded-full bg-[rgb(233,157,56)] mt-2 flex-shrink-0 group-hover:scale-150 transition-transform duration-300"></div>
                <div>
                  <h4 class="text-white font-bold text-sm uppercase tracking-wider mb-1 group-hover:text-[rgb(233,157,56)] transition-colors">
                    {ubi.nombre}
                  </h4>
                  <p class="text-white/60 text-xs font-light leading-relaxed">
                    {ubi.direccion}
                  </p>
                  <p class="text-white/40 text-[10px] font-light uppercase tracking-wider mt-1">
                    {ubi.evento}
                  </p>
                </div>
              </a>
            ))}
          </div>
        </div>

        <div class="mt-4 p-6 bg-white/5 border border-white/10 rounded-xl">
          <p class="text-white/70 text-sm font-light leading-relaxed">
            <span class="text-[rgb(233,157,56)] font-bold">Nota:</span> 
            Para consultas sobre contrataciones artísticas, por favor envía un dossier 
            o enlace a tu música a nuestro correo de información.
          </p>
        </div>
      </div>

    
    </div>
  </section>

  <script>
    document.addEventListener('submit', async (e) => {
      const form = e.target.closest('#contact-form');
      if (!form) return;
      e.preventDefault();

      const submitBtn = form.querySelector('button[type="submit"]');
      const textoOriginal = submitBtn?.textContent;
      if (submitBtn) {
        submitBtn.disabled = true;
        submitBtn.textContent = 'Enviando...';
      }

      const formData = new FormData(form);
      const data = {
        nombre: formData.get('nombre'),
        email: formData.get('email'),
        asunto: formData.get('asunto'),
        mensaje: formData.get('mensaje'),
        website: formData.get('website') || ''
      };

      try {
        const response = await fetch('/api/contacto', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(data)
        });

        if (response.ok) {
          form.reset();
          alert('¡Mensaje enviado con éxito! Te responderemos pronto.');
        } else {
          alert('Ha ocurrido un error. Inténtalo de nuevo o escríbenos a info@midnightboogie.net');
        }
      } catch (error) {
        alert('Error de conexión. Inténtalo de nuevo más tarde.');
      } finally {
        if (submitBtn) {
          submitBtn.disabled = false;
          submitBtn.textContent = textoOriginal;
        }
      }
    });
  </script>
</Layout>