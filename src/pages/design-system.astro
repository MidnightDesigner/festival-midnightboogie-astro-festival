  <!-- ========================================== -->
  <!-- SCRIPT: Toggle de biografía en el MOCK de Artist Card -->
  <!-- ========================================== -->
  <script is:inline>
    document.addEventListener('DOMContentLoaded', () => {
      const mockToggle = document.getElementById('mock-bio-toggle');
      const mockContent = document.getElementById('mock-bio-content');
      const mockText = document.getElementById('mock-bio-text');
      const mockArrow = document.getElementById('mock-bio-arrow');

      if (mockToggle && mockContent) {
        mockToggle.addEventListener('click', () => {
          const isExpanded = mockContent.style.maxHeight && mockContent.style.maxHeight !== '0px';
          
          if (isExpanded) {
            mockContent.style.maxHeight = '0px';
            mockContent.style.opacity = '0';
            mockText.textContent = 'Ver biografía completa';
            mockArrow.style.transform = 'rotate(0deg)';
          } else {
            // Forzamos un reflow para que la transición funcione
            mockContent.style.display = 'block';
            const scrollHeight = mockContent.scrollHeight;
            mockContent.style.maxHeight = scrollHeight + 'px';
            mockContent.style.opacity = '1';
            mockText.textContent = 'Ocultar biografía';
            mockArrow.style.transform = 'rotate(180deg)';
          }
        });
      }
    });
  </script>
