---
// src/pages/programa.astro
import Layout from '../layouts/Layout.astro';
import EventSchema from '../components/EventSchema.astro';
import EventoCard from '../components/EventoCard.astro';
import { programa2026 } from '../data/programa';

// Design System Imports
import PageHero from '../components/DesignSystem/PageHero.astro';
import SectionTitle from '../components/DesignSystem/SectionTitle.astro';
import Divider from '../components/DesignSystem/Divider.astro';
import TextMeta from '../components/DesignSystem/TextMeta.astro';
import Button from '../components/DesignSystem/Button.astro';

// URL base para compartir → HOME
const shareUrl = "https://midnightboogie.net";
const shareText = "¡No te pierdas el Midnight Boogie Weekend 2026! Soul, R&B y mucho más en Vitoria-Gasteiz. 🎸 Descargar Flyer: ";
---

<Layout 
  title="Programa y Horarios" 
  description="Programa oficial del Midnight Boogie Weekend 2026 en Vitoria-Gasteiz. Conciertos en Sala Arkabia y Helldorado, talleres y fiestas posteriores." 
  showStars={true}
>
  
  <main class="max-w-4xl mx-auto px-6 md:px-8 pb-16 space-y-16">
    
    <!-- HERO -->
    <PageHero 
      title="Programa" 
      highlight="2026" 
      subtitle="Conciertos en Sala Arkabia y Helldorado, talleres y fiestas posteriores." 
    />

    <!-- ✅ DIVIDER DEL DESIGN SYSTEM (Reemplaza al <hr> suelto) -->
    <Divider width="max-w-3xl" color="bg-[rgb(233,157,56)]/60" margin="mx-auto my-12" />
    
    <!-- ========================================== -->
    <!-- PRESENTACIÓN (SEPTIEMBRE) -->
    <!-- ========================================== -->
    <section class="px-0 md:px-4">
      <h2 class="font-avantgarde text-white text-3xl md:text-5xl font-light uppercase tracking-tight mb-4 drop-shadow-lg text-center">
        {programa2026.presentacion.dia} <span class="text-[rgb(233,157,56)]">Septiembre</span>
      </h2>

      <!-- ✅ TEXTMETA para la etiqueta -->
<div class="text-center mb-8">
  <TextMeta variant="section-tag" text={programa2026.presentacion.tag} />
</div>

      {programa2026.presentacion.eventos.map((evento, index) => {
        const primerArtista = evento.artistas?.[0];
        return (
          <>
            <EventSchema 
              evento={{
                nombre: `${primerArtista?.nombre || evento.titulo} - ${evento.lugar}`,
                fechaInicio: "2026-09-12",
                lugar: evento.lugar,
                direccion: evento.direccion || "",
                ciudad: "Vitoria-Gasteiz",
                provincia: "Álava",
                pais: "ES",
                codigoPostal: "01001",
                precio: evento.precio || "0",
                urlEntrada: evento.link,
                organizador: "Stone Foundation",
                descripcion: `${primerArtista?.nombre || evento.titulo} en ${evento.lugar}.`,
                imagen: primerArtista?.imagen ? `/images/artistas/${primerArtista.nombre.toLowerCase().replace(/\s+/g, '-')}.jpg` : undefined
              }} 
            />
            <div class={index > 0 ? "max-w-2xl mx-auto border-t border-white/10 pt-12 mt-12" : ""}>
              <EventoCard evento={evento} />
            </div>
          </>
        );
      })}
    </section>

    <Divider width="max-w-3xl" color="bg-[rgb(233,157,56)]/60" margin="mx-auto my-12" />

    <!-- ========================================== -->
    <!-- VIERNES 27 NOVIEMBRE -->
    <!-- ========================================== -->
    <section class="px-0 md:px-4">
      <h2 class="font-avantgarde text-white text-3xl md:text-5xl font-light uppercase tracking-tight mb-4 drop-shadow-lg text-center">
        {programa2026.viernes.dia} <span class="text-[rgb(233,157,56)]">Noviembre</span>
      </h2>

      <p class="sr-only">{programa2026.viernes.tag}</p>

      {programa2026.viernes.eventos.map((evento, index) => {
        const primerArtista = evento.artistas?.[0];
        return (
          <>
            <EventSchema 
              evento={{
                nombre: `${primerArtista?.nombre || evento.titulo} - ${evento.lugar}`,
                fechaInicio: "2026-11-27",
                lugar: evento.lugar,
                direccion: evento.direccion || "",
                ciudad: "Vitoria-Gasteiz",
                provincia: "Álava",
                pais: "ES",
                codigoPostal: "01001",
                precio: evento.precio || "0",
                urlEntrada: evento.link,
                organizador: "Stone Foundation",
                descripcion: `${primerArtista?.nombre || evento.titulo} en ${evento.lugar}.`,
                imagen: primerArtista?.imagen ? `/images/artistas/${primerArtista.nombre.toLowerCase().replace(/\s+/g, '-')}.jpg` : undefined
              }} 
            />
            <div class={index > 0 ? "max-w-2xl mx-auto border-t border-white/10 pt-12 mt-12" : ""}>
              <EventoCard evento={evento} />
            </div>
          </>
        );
      })}
    </section>

    <Divider width="max-w-3xl" color="bg-[rgb(233,157,56)]/60" margin="mx-auto my-12" />

    <!-- ========================================== -->
    <!-- SÁBADO 28 - TALLER FAMILIAR -->
    <!-- ========================================== -->
    <section class="px-0 md:px-4">
      <h2 class="font-avantgarde text-white text-3xl md:text-5xl font-light uppercase tracking-tight mb-4 drop-shadow-lg text-center">
        {programa2026.sabadoTaller.dia} <span class="text-[rgb(233,157,56)]">Noviembre</span>
      </h2>

<div class="text-center mb-8">
  <TextMeta variant="section-tag" text={programa2026.sabadoTaller.tag} />
</div>

      {programa2026.sabadoTaller.eventos.map((evento, index) => {
        const primerArtista = evento.artistas?.[0];
        return (
          <>
            <EventSchema 
              evento={{
                nombre: `${primerArtista?.nombre || evento.titulo} - ${evento.lugar}`,
                fechaInicio: "2026-11-28",
                lugar: evento.lugar,
                direccion: evento.direccion || "",
                ciudad: "Vitoria-Gasteiz",
                provincia: "Álava",
                pais: "ES",
                codigoPostal: "01001",
                precio: evento.precio || "0",
                urlEntrada: evento.link,
                organizador: "Stone Foundation",
                descripcion: `${primerArtista?.nombre || evento.titulo} - Taller familiar en ${evento.lugar}.`,
                imagen: primerArtista?.imagen ? `/images/artistas/${primerArtista.nombre.toLowerCase().replace(/\s+/g, '-')}.jpg` : undefined
              }} 
            />
            <div class={index > 0 ? "max-w-2xl mx-auto border-t border-white/10 pt-12 mt-12" : ""}>
              <EventoCard evento={evento} />
            </div>
          </>
        );
      })}
    </section>

    <Divider width="max-w-3xl" color="bg-[rgb(233,157,56)]/60" margin="mx-auto my-12" />

    <!-- ========================================== -->
    <!-- SÁBADO 28 - NOCHE DE SOUL & R'N'R -->
    <!-- ========================================== -->
    <section class="px-0 md:px-4">
      <h2 class="font-avantgarde text-white text-3xl md:text-5xl font-light uppercase tracking-tight mb-4 drop-shadow-lg text-center">
        {programa2026.sabadoNoche.dia} <span class="text-[rgb(233,157,56)]">Noviembre</span>
      </h2>

      <p class="sr-only">{programa2026.sabadoNoche.tag}</p>

      {programa2026.sabadoNoche.eventos.map((evento, index) => {
        const primerArtista = evento.artistas?.[0];
        return (
          <>
            <EventSchema 
              evento={{
                nombre: `${primerArtista?.nombre || evento.titulo} - ${evento.lugar}`,
                fechaInicio: "2026-11-28",
                lugar: evento.lugar,
                direccion: evento.direccion || "",
                ciudad: "Vitoria-Gasteiz",
                provincia: "Álava",
                pais: "ES",
                codigoPostal: "01001",
                precio: evento.precio || "0",
                urlEntrada: evento.link,
                organizador: "Stone Foundation",
                descripcion: `${primerArtista?.nombre || evento.titulo} - Noche de Soul & Rock'n'Roll en ${evento.lugar}.`,
                imagen: primerArtista?.imagen ? `/images/artistas/${primerArtista.nombre.toLowerCase().replace(/\s+/g, '-')}.jpg` : undefined
              }} 
            />
            <div class={index > 0 ? "max-w-2xl mx-auto border-t border-white/10 pt-12 mt-12" : ""}>
              <EventoCard evento={evento} />
            </div>
          </>
        );
      })}
    </section>

        <!-- BLOQUE DE ABONO AL FINAL -->
    {programa2026.abono && (
      <div class="flex justify-center mt-16 mb-12">
        <div class="flex flex-col items-center bg-white/5 backdrop-blur-md border border-[rgb(233,157,56)]/50 rounded-2xl px-8 py-8 md:px-12 md:py-10 text-center max-w-md w-full">
          
          <TextMeta variant="price" text={`Abono Weekend: ${programa2026.abono.precio}`} class="justify-center" />
          <TextMeta variant="tag" text={programa2026.abono.descripcion} class="justify-center" />
          
          {programa2026.abono.link && (
            <Button href={programa2026.abono.link} variant="primary" class="w-full justify-center gap-2">
              {programa2026.abono.linkTexto}
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-4 h-4">
                <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 6H5.25A2.25 2.25 0 003 8.25v10.5A2.25 2.25 0 005.25 21h10.5A2.25 2.25 0 0018 18.75V10.5m-10.5 6L21 3m0 0h-5.25M21 3v5.25" />
              </svg>
            </Button>
          )}
          
        </div>
      </div>
    )}


    <!-- ========================================== -->
    <!-- SECCIÓN DE FLYERS Y MATERIAL PROMOCIONAL   -->
    <!-- ========================================== -->
    <section class="mt-24 md:mt-32">
      <!-- ✅ SECTION TITLE DEL DESIGN SYSTEM -->
      <SectionTitle title="Material Promocional" align="center" />
      
      <!-- ✅ TEXTMETA para el subtítulo -->
  <TextMeta variant="default-center" text="Descarga nuestros flyers oficiales para compartir con tus amigos o imprimir." />

      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        
        <!-- FLYER 1: PRESENTACIÓN -->
        <div class="bg-white/5 border border-white/10 rounded-2xl p-6 hover:border-[rgb(233,157,56)]/40 transition-colors duration-300">
          <div class="aspect-[3/4] bg-black/30 rounded-lg overflow-hidden mb-6 flex items-center justify-center border border-white/5">
            <img src="/images/2026/FLYERS_MNB_2026_PRESENTACION-01.png" alt="Flyer Presentación Midnight Boogie" class="w-full h-full object-contain p-4" />
          </div>
          
          <h3 class="text-white font-medium text-xl mb-2 text-center">Flyer Presentación</h3>
          <TextMeta variant="tag-center" text="Conciertos de presentación y primeras fechas." class="justify-center mb-6" />
          
          <!-- ✅ BUTTON DEL DESIGN SYSTEM (con atributo download) -->
          <Button href="/images/2026/FLYERS_MNB_2026_PRESENTACION.pdf" variant="primary" class="w-full justify-center mb-4" download>
            Descargar PDF
          </Button>

          <!-- Botones Compartir -->
          <div class="flex justify-center gap-3 pt-4 border-t border-white/10">
            <a href={`https://wa.me/?text=${encodeURIComponent(shareText + shareUrl)}`} target="_blank" rel="noopener noreferrer" class="w-10 h-10 rounded-full bg-white/10 flex items-center justify-center hover:bg-[#25D366] hover:text-white transition-colors" aria-label="Compartir en WhatsApp">
              <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/></svg>
            </a>
            <a href={`https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(shareUrl)}`} target="_blank" rel="noopener noreferrer" class="w-10 h-10 rounded-full bg-white/10 flex items-center justify-center hover:bg-[#1877F2] hover:text-white transition-colors" aria-label="Compartir en Facebook">
              <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
            </a>
            <button class="copy-link-btn w-10 h-10 rounded-full bg-white/10 flex items-center justify-center hover:bg-gradient-to-tr hover:from-[#feda75] hover:via-[#d62976] hover:to-[#962fbf] hover:text-white transition-all" data-url={shareUrl} aria-label="Copiar enlace para Instagram">
              <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/></svg>
            </button>
          </div>
        </div>

        <!-- FLYER 2: FESTIVAL COMPLETO -->
        <div class="bg-white/5 border border-[rgb(233,157,56)]/60 rounded-2xl p-6 hover:border-[rgb(233,157,56)] transition-colors duration-300 relative">
          <div class="absolute top-4 right-4 bg-[rgb(233,157,56)] text-black text-[10px] font-bold uppercase tracking-widest px-3 py-1 rounded-full">
            Recomiéndalo
          </div>
          
          <div class="aspect-[3/4] bg-black/30 rounded-lg overflow-hidden mb-6 flex items-center justify-center border border-white/5">
            <img src="/images/2026/programa-mbw-2026-01.png" alt="Flyer Festival Completo Midnight Boogie" class="w-full h-full object-contain p-4" />
          </div>
          
          <h3 class="text-white font-medium text-xl mb-2 text-center">Flyer Festival Completo</h3>
          <TextMeta variant="tag-center" text="Programación completa, artistas y detalles del evento." class="justify-center mb-6" />
          
          <Button href="/images/2026/MIDNIGHT-BOOGIE-WEEKEND-2026.pdf" variant="primary" class="w-full justify-center mb-4" download>
            Descargar PDF
          </Button>

          <!-- Botones Compartir -->
          <div class="flex justify-center gap-3 pt-4 border-t border-white/10">
            <a href={`https://wa.me/?text=${encodeURIComponent(shareText + shareUrl)}`} target="_blank" rel="noopener noreferrer" class="w-10 h-10 rounded-full bg-white/10 flex items-center justify-center hover:bg-[#25D366] hover:text-white transition-colors" aria-label="Compartir en WhatsApp">
              <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/></svg>
            </a>
            <a href={`https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(shareUrl)}`} target="_blank" rel="noopener noreferrer" class="w-10 h-10 rounded-full bg-white/10 flex items-center justify-center hover:bg-[#1877F2] hover:text-white transition-colors" aria-label="Compartir en Facebook">
              <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
            </a>
            <button class="copy-link-btn w-10 h-10 rounded-full bg-white/10 flex items-center justify-center hover:bg-gradient-to-tr hover:from-[#feda75] hover:via-[#d62976] hover:to-[#962fbf] hover:text-white transition-all" data-url={shareUrl} aria-label="Copiar enlace para Instagram">
              <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/></svg>
            </button>
          </div>
        </div>

      </div>

      <!-- Toast de confirmación -->
      <div id="copy-toast" class="fixed bottom-8 left-1/2 -translate-x-1/2 bg-white text-black px-6 py-3 rounded-full shadow-2xl font-medium text-sm opacity-0 pointer-events-none transition-opacity duration-300 z-50">
        ¡Enlace copiado! Pégalo en Instagram
      </div>
    </section>

  </main>

  <script>
    document.addEventListener('click', async (e) => {
      const button = e.target.closest('.copy-link-btn');
      if (!button) return;

      const url = button.getAttribute('data-url');
      const toast = document.getElementById('copy-toast');
      try {
        await navigator.clipboard.writeText(url);
        toast?.classList.remove('opacity-0');
        toast?.classList.add('opacity-100');
        setTimeout(() => {
          toast?.classList.remove('opacity-100');
          toast?.classList.add('opacity-0');
        }, 2000);
      } catch (err) {
        alert('No se pudo copiar el enlace. Por favor, cópialo manualmente: ' + url);
      }
    });
  </script>

</Layout>