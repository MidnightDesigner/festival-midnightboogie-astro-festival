---
import Analytics from '@vercel/analytics/astro';
import '../styles/global.css';
import Header from '../components/shared/Header.astro';
import Footer from '../components/shared/Footer.astro';
import StarBackground from '../components/ui/StarBackground.astro';
import { getRelativeLocaleUrl } from 'astro:i18n';

interface Props {
  title: string;
  description?: string;
  image?: string;
  showFooter?: boolean;
  showStars?: boolean;
}

const {
  title,
  description = "Midnight Boogie Festival - El mejor soul, blues y rhythm & blues en Vitoria-Gasteiz.",
  image = "/images/og-default.png",
  showFooter = true,
  showStars = true
} = Astro.props;

const siteUrl = "https://www.midnightboogie.net";
const fullTitle = title?.includes("Midnight Boogie") ? title : `${title || 'Midnight Boogie'} | Midnight Boogie 2026`;
const fullImageUrl = image?.startsWith("http") ? image : `${siteUrl}${image || '/images/og-default.png'}`;

const currentLocale = Astro.currentLocale || 'es';

function stripLocale(pathname: string) {
  for (const l of ['eu', 'en', 'fr']) {
    if (pathname === `/${l}` || pathname === `/${l}/`) return '/';
    if (pathname.startsWith(`/${l}/`)) return pathname.slice(`/${l}`.length);
  }
  return pathname;
}

const basePath = stripLocale(Astro.url.pathname);
const cleanPath = basePath === '/' ? '' : basePath.replace(/\/+$/, '');
const currentUrl = `${siteUrl}${Astro.url.pathname}`;

const localeUrls = {
  es: `${siteUrl}${getRelativeLocaleUrl('es', cleanPath)}`,
  eu: `${siteUrl}${getRelativeLocaleUrl('eu', cleanPath)}`,
  en: `${siteUrl}${getRelativeLocaleUrl('en', cleanPath)}`,
  fr: `${siteUrl}${getRelativeLocaleUrl('fr', cleanPath)}`,
};

const ogLocaleMap: Record<string, string> = {
  es: 'es_ES',
  eu: 'eu_ES',
  en: 'en_GB',
  fr: 'fr_FR',
};
const ogLocale = ogLocaleMap[currentLocale] || 'es_ES';
---

<!doctype html>
<html lang={currentLocale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Jost:wght@300;400;500;600;700;900&display=swap" rel="stylesheet" />
    
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={currentUrl} />
    <meta name="robots" content="index, follow" />
    <meta name="view-transition" content="same-origin" />
    
    <link rel="alternate" hreflang="es-ES" href={localeUrls.es} />
    <link rel="alternate" hreflang="eu" href={localeUrls.eu} />
    <link rel="alternate" hreflang="en-GB" href={localeUrls.en} />
    <link rel="alternate" hreflang="fr-FR" href={localeUrls.fr} />
    <link rel="alternate" hreflang="x-default" href={localeUrls.es} />
    
    <meta property="og:type" content="website" />
    <meta property="og:url" content={currentUrl} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={fullImageUrl} />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:locale:alternate" content="es_ES" />
    <meta property="og:locale:alternate" content="eu_ES" />
    <meta property="og:locale:alternate" content="en_GB" />
    <meta property="og:locale:alternate" content="fr_FR" />
    <meta property="og:site_name" content="Midnight Boogie" />
    
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={currentUrl} />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={fullImageUrl} />
    <meta name="twitter:creator" content="@midnightboogie" />
    
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    


  <link rel="preload" as="image" href="/images/fondo-estrellas.avif" type="image/avif" fetchpriority="high" />

   
    
 

    {Astro.url.pathname === '/' && (
      <script type="application/ld+json" set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "MusicFestival",
        "name": "Midnight Boogie Weekend 2026",
        "startDate": "2026-09-12",
        "endDate": "2026-11-28",
        "location": {
          "@type": "Place",
          "name": "Vitoria-Gasteiz",
          "address": {
            "@type": "PostalAddress",
            "addressLocality": "Vitoria-Gasteiz",
            "addressRegion": "Álava",
            "addressCountry": "ES"
          }
        },
        "organizer": {
          "@type": "Organization",
          "name": "Midnight Boogie Festival",
          "url": "https://www.midnightboogie.net"
        },
        "image": "https://www.midnightboogie.net/images/festival-hero.jpg"
      })} />
    )}
  </head>
  
  <body class="m-0 p-0 bg-background text-foreground font-sans antialiased flex flex-col min-h-screen relative">
    {showStars && <StarBackground transition:persist />}
    
    <Header />
    
    <main class="flex-grow relative z-10 pt-20 md:pt-[120px]">
      <slot />
    </main>
    
    {showFooter && <Footer />}
    
    <Analytics />
  </body>
</html>